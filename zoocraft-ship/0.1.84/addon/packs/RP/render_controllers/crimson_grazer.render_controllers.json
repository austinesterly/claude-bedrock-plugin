{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.zoocraft.crimson_grazer": {
      "arrays": {
        "textures": {"Array.skins": ["Texture.default", "Texture.sleep", "Texture.calf", "Texture.calf_sleep"]}
      },
      "geometry": "Geometry.default",
      "materials": [{"*": "Material.default"}],
      "textures": ["Array.skins[(query.is_baby ? 2 : 0) + ((query.property('zoocraft:act') == 3) ? 1 : 0)]"],
      "part_visibility": [
        {"*": true},
        {"boss": "!query.is_baby && query.mark_variant == 1"},
        {"hornL": "!query.is_baby"},
        {"hornR": "!query.is_baby"},
        {"caps": "!query.is_baby"}
      ]
    }
  }
}

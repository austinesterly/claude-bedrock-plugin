      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            {"walking": "query.property('zoocraft:act') == 0 && query.modified_move_speed > 0.05"},
            {"graze": "query.property('zoocraft:act') == 1"},
            {"rub": "query.property('zoocraft:act') == 2"},
            {"rest": "query.property('zoocraft:act') == 3"},
            {"chew": "query.property('zoocraft:act') == 4"},

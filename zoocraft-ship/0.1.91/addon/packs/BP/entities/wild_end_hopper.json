        "add": {"component_groups": ["zoocraft:coat_1"]}
      },
      "zoocraft:seek_feeder": {"add": {"component_groups": ["zoocraft:seek_feeder"]}},
      "zoocraft:seek_none": {"remove": {"component_groups": ["zoocraft:seek_feeder"]}},
      "minecraft:entity_spawned": {
        "randomize": [
          {"weight": 3, "add": {"component_groups": ["zoocraft:coat_0", "zoocraft:moving"]}},
          {"weight": 1, "add": {"component_groups": ["zoocraft:coat_1", "zoocraft:moving"]}}

          "priority": 4,
          "tick_interval": 20,
          "start_chance": 1.0,
          "search_range": 16,
          "search_height": 3,
          "goal_radius": 1.2,
          "speed_multiplier": 1.0,
          "target_selection_method": "nearest",
          "target_blocks": ["zoocraft:basic_feeder"],
          "target_offset": [0, 0, 0],
          "stay_duration": 60
        }
      }
    },
    "components": {
      "minecraft:type_family": {"family": ["wild_end_hopper", "end_hopper", "mob"]},
      "minecraft:nameable": {},
      "minecraft:health": {"value": 8, "max": 8},
      "minecraft:damage_sensor": {"triggers": [{"cause": "fall", "deals_damage": "no"}]},
      "minecraft:despawn": {"despawn_from_distance": {}},
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:breathable": {"total_supply": 15, "suffocate_time": 0},
      "minecraft:collision_box": {"width": 0.35, "height": 0.45},
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "blocks_to_avoid": [{"name": "zoocraft:landing_pad"}]
      },
      "minecraft:movement.basic": {},
      "minecraft:movement": {"value": 0.2},
      "minecraft:jump.static": {},

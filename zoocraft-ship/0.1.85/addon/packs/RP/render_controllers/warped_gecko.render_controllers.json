{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.zoocraft.warped_gecko": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.slit",
            "Texture.female",
            "Texture.female_slit",
            "Texture.hatchling",
            "Texture.hatchling_slit"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [{"*": "Material.default"}],
      "textures": [
        "Array.skins[(query.is_baby ? 4 : (query.mark_variant == 1 ? 0 : 2)) + ((query.property('zoocraft:act') == 10 || query.property('zoocraft:act') == 11) ? 1 : 0)]"
      ],
      "part_visibility": [{"*": true}, {"tongue": "query.property('zoocraft:act') == 7"}]
    }
  }
}

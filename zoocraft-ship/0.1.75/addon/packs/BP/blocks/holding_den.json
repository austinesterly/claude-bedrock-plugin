        "mesh": {"texture": "zoocraft_den_mesh", "render_method": "alpha_test"},
        "dark": {"texture": "zoocraft_den_dark", "render_method": "alpha_test"},
        "eyes": {"texture": "zoocraft_den_eyes", "render_method": "alpha_test"},
        "straw": {"texture": "zoocraft_den_straw", "render_method": "alpha_test"},
        "roof": {"texture": "zoocraft_den_roof", "render_method": "alpha_test"},

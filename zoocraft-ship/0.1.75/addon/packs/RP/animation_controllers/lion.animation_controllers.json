            {"lick": "v.posture == 0 && v.act == 9 && (q.life_time - v.st) > 1.5"},
            {"sniff": "v.posture == 0 && v.act == 10 && (q.life_time - v.st) > 1.5"},
            {"flehmen": "v.posture == 0 && v.act == 11 && (q.life_time - v.st) > 1.5"},
            {"spray": "v.posture == 0 && v.act == 12 && (q.life_time - v.st) > 1.5"},
            {"scrape": "v.posture == 0 && v.act == 13 && (q.life_time - v.st) > 1.5"},
            {"suckle": "v.posture == 0 && v.act == 14 && (q.life_time - v.st) > 1.5"},
            {"play": "v.posture == 0 && v.act == 15 && (q.life_time - v.st) > 1.5"},
            {"drink": "v.posture == 0 && v.act == 16 && (q.life_time - v.st) > 1.5"},
            {"feed": "v.posture == 0 && v.act == 17 && (q.life_time - v.st) > 1.5"},
            {"stalk": "v.posture == 0 && v.act == 20 && (q.life_time - v.st) > 1.5"},
            {"trot": "v.posture == 0 && v.act == 21 && (q.life_time - v.st) > 1.5"},
            {"gallop": "v.posture == 0 && v.act == 22 && (q.life_time - v.st) > 1.5"},
            {"walk_t": "v.posture == 0 && v.act == 23 && (q.life_time - v.st) > 1.5"},
            {"yawn": "v.posture == 0 && v.act == 24 && (q.life_time - v.st) > 1.5"},
            {"claw": "v.posture == 0 && v.act == 25 && (q.life_time - v.st) > 1.5"}
          ]
        },
        "to_sleep": {
          "animations": ["to_sleep", "sleep", "down_life", "eat_w"],
          "on_entry": ["v.st = q.life_time; v.in_sleep = 1;"],
          "transitions": [
            {"sleep": "(q.life_time - v.st) > 1.3 && v.posture == 3"},
            {"to_back": "(q.life_time - v.st) > 1.3 && v.posture == 4"},
            {"wake": "(q.life_time - v.st) > 1.3 && v.posture < 3"}
          ],
          "blend_transition": 0
        },
        "sleep": {
          "animations": ["sleep_side", "sleep", "down_life", "nurse_w"],
          "on_entry": ["v.in_sleep = 1; v.in_side = 1;"],
          "on_exit": ["v.in_side = 0;"],
          "transitions": [{"to_back": "v.posture == 4"}, {"wake": "v.posture < 3"}],
          "blend_transition": 0
        },
        "wake": {
          "animations": ["wake", "sleep", "down_life", "nurse_w"],
          "on_entry": ["v.st = q.life_time; v.in_sleep = 0;"],
          "transitions": [
            {"lie": "(q.life_time - v.st) > 1.2 && v.posture == 2"},
            {"get_up": "(q.life_time - v.st) > 1.2 && v.posture < 2"},
            {"to_sleep": "(q.life_time - v.st) > 1.2 && v.posture >= 3"}
          ],
          "blend_transition": 0
        },
        "to_back": {
          "animations": ["to_back", "sleep", "down_life", "nurse_w"],
          "on_entry": ["v.st = q.life_time;"],
          "transitions": [{"back": "(q.life_time - v.st) > 1 && 1"}],
          "blend_transition": 0
        },
        "back": {
          "animations": ["sleep_back", "sleep", "down_life"],
          "transitions": [{"from_back": "v.posture != 4"}],
          "blend_transition": 0
        },
        "from_back": {
          "animations": ["from_back", "sleep", "down_life"],
          "on_entry": ["v.st = q.life_time;"],
          "transitions": [{"sleep": "(q.life_time - v.st) > 1 && 1"}],
          "blend_transition": 0
        }
      }
    }
  }
}

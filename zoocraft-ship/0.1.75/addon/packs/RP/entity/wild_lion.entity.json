{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "zoocraft:wild_lion",
      "materials": {"default": "entity_alphatest"},
      "textures": {
        "default": "textures/entity/zoocraft/lioness",
        "lion": "textures/entity/zoocraft/lion",
        "lion_dark": "textures/entity/zoocraft/lion_dark",
        "cub": "textures/entity/zoocraft/lion_cub"
      },
      "geometry": {"default": "geometry.zoocraft.lion"},
      "animations": {
        "walk": "animation.zoocraft.lion.walk",
        "walk_t": "animation.zoocraft.lion.walk_t",
        "trot": "animation.zoocraft.lion.trot",
        "gallop": "animation.zoocraft.lion.gallop",
        "stalk": "animation.zoocraft.lion.stalk",
        "idle": "animation.zoocraft.lion.idle",
        "alert": "animation.zoocraft.lion.alert",
        "warn": "animation.zoocraft.lion.warn",
        "swipe": "animation.zoocraft.lion.swipe",
        "roar": "animation.zoocraft.lion.roar",
        "rub": "animation.zoocraft.lion.rub",
        "lick": "animation.zoocraft.lion.lick",
        "sniff": "animation.zoocraft.lion.sniff",
        "flehmen": "animation.zoocraft.lion.flehmen",
        "spray": "animation.zoocraft.lion.spray",
        "scrape": "animation.zoocraft.lion.scrape",
        "suckle": "animation.zoocraft.lion.suckle",
        "play": "animation.zoocraft.lion.play",
        "play_life": "animation.zoocraft.lion.play_life",
        "drink": "animation.zoocraft.lion.drink",
        "feed": "animation.zoocraft.lion.feed",
        "eat": "animation.zoocraft.lion.eat",
        "yawn": "animation.zoocraft.lion.yawn",
        "claw": "animation.zoocraft.lion.claw",
        "look_at_target": "animation.zoocraft.lion.look_at_target",
        "lie_down": "animation.zoocraft.lion.lie_down",
        "get_up": "animation.zoocraft.lion.get_up",
        "to_sleep": "animation.zoocraft.lion.to_sleep",
        "wake": "animation.zoocraft.lion.wake",
        "to_back": "animation.zoocraft.lion.to_back",
        "from_back": "animation.zoocraft.lion.from_back",
        "sit_down": "animation.zoocraft.lion.sit_down",
        "sit_up": "animation.zoocraft.lion.sit_up",
        "sit": "animation.zoocraft.lion.sit",
        "lie": "animation.zoocraft.lion.lie",
        "sleep_side": "animation.zoocraft.lion.sleep_side",
        "sleep_back": "animation.zoocraft.lion.sleep_back",
        "down_life": "animation.zoocraft.lion.down_life",
        "sleep": "animation.zoocraft.lion.sleep",
        "nurse_head": "animation.zoocraft.lion.nurse_head",
        "leg_rake_l": "animation.zoocraft.lion.leg_rake_l",
        "leg_rake_r": "animation.zoocraft.lion.leg_rake_r",
        "cub": "animation.zoocraft.lion.cub",
        "eat_w": "animation.zoocraft.lion.eat_w",
        "nurse_w": "animation.zoocraft.lion.nurse_w",
        "move": "controller.animation.zoocraft.lion.move"
      },
      "render_controllers": ["controller.render.zoocraft.lion"],
      "scripts": {
        "scale": "q.is_baby ? 0.24 : (q.variant == 1 ? 0.575 : 0.5)",
        "initialize": [
          "v.offset = math.random(0, 24);",
          "v.st = 0;",
          "v.act_st = 0;",
          "v.act_was = -1;",
          "v.is_down = 0;",
          "v.gait = 0;",
          "v.t_prev = 0;",
          "v.rest_head = 0;",
          "v.awake = 1;",
          "v.in_lie = 0;",
          "v.in_sleep = 0;",
          "v.leg_rate = 1;",
          "v.posture = 0;",
          "v.lids = 0;",
          "v.eat_k = 0;",
          "v.nurse_k = 0;",
          "v.in_side = 0;",
          "v.side_k = 0;",
          "v.back_k = 0;",
          "v.rake_l = 0;",
          "v.rake_r = 0;"
        ],
        "pre_animation": [
          "v.act = q.property('zoocraft:act');",
          "v.act_st = v.act != v.act_was ? q.life_time : v.act_st; v.act_was = v.act;",
          "v.posture = v.act == 19 ? 1 : ((v.act == 5 || v.act == 18) ? 2 : ((v.act == 6 || (v.act == 14 && !q.is_baby)) ? 3 : (v.act == 7 ? 4 : 0)));",
          "v.gait = q.modified_move_speed <= 0.05 ? 0 : (q.ground_speed >= (v.gait == 3 ? 3.2 : 3.8) ? 3 : (q.ground_speed >= (v.gait >= 2 ? 1.6 : 2.0) ? 2 : 1));",
          "v.dt = math.clamp(q.life_time - v.t_prev, 0, 0.25); v.t_prev = q.life_time;",
          "v.rest_head = v.rest_head + math.clamp(v.in_lie * (v.act == 5 ? (math.clamp((math.mod(q.life_time + v.offset, 30) - 10) / 2.0, 0, 1) * math.clamp((22 - math.mod(q.life_time + v.offset, 30)) / 2.0, 0, 1)) : 0) - v.rest_head, -v.dt / 0.6, v.dt / 0.6);",
          "v.awake = v.awake + math.clamp((v.in_sleep && v.act != 14 ? 0 : 1) - v.awake, -v.dt / 1.5, v.dt / 1.5);",
          "v.lids = v.awake < 0.5;",
          "v.eat_k = v.eat_k + math.clamp((v.in_lie && v.act == 18 ? 1 : 0) - v.eat_k, -v.dt / 0.5, v.dt / 0.5);",
          "v.nurse_k = v.nurse_k + math.clamp((v.in_side && v.act == 14 ? 1 : 0) - v.nurse_k, -v.dt / 0.6, v.dt / 0.6);",
          "v.side_k = v.side_k + math.clamp(v.in_sleep - v.side_k, -v.dt / 1.2, v.dt / 1.2);",
          "v.back_k = v.back_k + math.clamp((v.posture == 4 ? 1 : 0) - v.back_k, -v.dt, v.dt);",
          "v.leg_rate = 0.5 / (q.is_baby ? 0.24 : (q.variant == 1 ? 0.575 : 0.5));",
          "v.trot_rate = (v.act == 21 ? 1 : math.clamp(q.ground_speed / 2.5, 0.5, 2)) * v.leg_rate;",
          "v.gallop_rate = (v.act == 22 ? 1 : math.clamp(q.ground_speed / 6, 0.5, 1.6)) * v.leg_rate;",
          "v.rake_l = v.act == 13 ? (v.act == 13 ? (math.mod(q.life_time - v.act_st + 0, 2.4) < 0.5 ? math.mod(q.life_time - v.act_st + 0, 2.4) : (math.mod(q.life_time - v.act_st + 0, 2.4) < 0.85 ? 0.5 + (math.mod(q.life_time - v.act_st + 0, 2.4) - 0.5) / 0.7 : (math.mod(q.life_time - v.act_st + 0, 2.4) < 1.2 ? 1 - (math.mod(q.life_time - v.act_st + 0, 2.4) - 0.85) / 0.35 : 0))) : 0) : math.max(0, v.rake_l - v.dt / 0.3);",
          "v.rake_r = v.act == 13 ? (v.act == 13 ? (math.mod(q.life_time - v.act_st + 1.2, 2.4) < 0.5 ? math.mod(q.life_time - v.act_st + 1.2, 2.4) : (math.mod(q.life_time - v.act_st + 1.2, 2.4) < 0.85 ? 0.5 + (math.mod(q.life_time - v.act_st + 1.2, 2.4) - 0.5) / 0.7 : (math.mod(q.life_time - v.act_st + 1.2, 2.4) < 1.2 ? 1 - (math.mod(q.life_time - v.act_st + 1.2, 2.4) - 0.85) / 0.35 : 0))) : 0) : math.max(0, v.rake_r - v.dt / 0.3);"
        ],
        "animate": [
          "move",
          {"cub": "q.is_baby"},
          {"leg_rake_l": "v.rake_l > 0"},
          {"leg_rake_r": "v.rake_r > 0"}
        ]
      },
      "spawn_egg": {"base_color": "#c49a62", "overlay_color": "#5b3a20"}
    }
  }
}

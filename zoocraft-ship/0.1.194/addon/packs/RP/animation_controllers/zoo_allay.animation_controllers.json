{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.zoocraft.zoo_allay.look_at_target": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "looking_at_target": "!query.property('zoocraft:dancing')"
            }
          ]
        },
        "looking_at_target": {
          "animations": [
            "look_at_target_default"
          ],
          "transitions": [
            {
              "default": "query.property('zoocraft:dancing')"
            }
          ]
        }
      }
    },
    "controller.animation.zoocraft.zoo_allay.dancing": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "dancing": "query.property('zoocraft:dancing')"
            }
          ],
          "blend_transition": 0.2
        },
        "dancing": {
          "animations": [
            "dance"
          ],
          "transitions": [
            {
              "default": "!query.property('zoocraft:dancing')"
            }
          ]
        }
      }
    }
  }
}

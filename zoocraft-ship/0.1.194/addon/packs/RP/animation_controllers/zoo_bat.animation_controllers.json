{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.zoocraft.zoo_bat.move": {
      "initial_state": "flying",
      "states": {
        "flying": {
          "animations": [
            "flying"
          ],
          "transitions": [
            {
              "resting": "query.property('zoocraft:roost')"
            }
          ]
        },
        "resting": {
          "animations": [
            "resting"
          ],
          "transitions": [
            {
              "flying": "!query.property('zoocraft:roost')"
            }
          ]
        }
      }
    }
  }
}

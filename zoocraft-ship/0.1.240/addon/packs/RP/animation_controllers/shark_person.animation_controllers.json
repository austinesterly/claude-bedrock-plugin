{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.zoocraft.shark_person.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "walk": "q.modified_move_speed > 0.05"
            }
          ],
          "blend_transition": 0.2
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "idle": "q.modified_move_speed <= 0.05"
            }
          ],
          "blend_transition": 0.2
        }
      }
    }
  }
}

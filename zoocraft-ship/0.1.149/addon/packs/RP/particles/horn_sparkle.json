{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "zoocraft:horn_sparkle",
      "basic_render_parameters": {"material": "particles_blend", "texture": "textures/particle/particles"}
    },
    "components": {
      "minecraft:emitter_rate_instant": {"num_particles": 1},
      "minecraft:emitter_lifetime_once": {"active_time": 0.05},
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": ["math.random(-0.25, 0.25)", 1, "math.random(-0.25, 0.25)"]
      },
      "minecraft:particle_lifetime_expression": {"max_lifetime": "0.9 + variable.particle_random_3 * 0.8"},
      "minecraft:particle_initial_speed": 1.6,
      "minecraft:particle_motion_dynamic": {"linear_acceleration": [0, 0.4, 0], "linear_drag_coefficient": 2.2},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.05 + 0.035 * math.abs(math.sin(variable.particle_age * 500 + variable.particle_random_1 * 360))",
          "0.05 + 0.035 * math.abs(math.sin(variable.particle_age * 500 + variable.particle_random_1 * 360))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {"texture_width": 128, "texture_height": 128, "uv": [56, 0], "uv_size": [8, 8]}
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.particle_random_2 < 0.35 ? 1.0 : (variable.particle_random_2 < 0.6 ? 0.78 : (variable.particle_random_2 < 0.85 ? 0.68 : 1.0))",
          "variable.particle_random_2 < 0.35 ? 1.0 : (variable.particle_random_2 < 0.6 ? 0.68 : (variable.particle_random_2 < 0.85 ? 0.98 : 0.72))",
          "variable.particle_random_2 < 0.35 ? 1.0 : (variable.particle_random_2 < 0.6 ? 1.0 : (variable.particle_random_2 < 0.85 ? 0.88 : 0.82))",
          "math.clamp((variable.particle_lifetime - variable.particle_age) * 2, 0, 1)"
        ]
      }
    }
  }
}

{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.zoocraft.unicorn": {
      "arrays": {"textures": {"Array.coats": ["Texture.default", "Texture.dawn", "Texture.foal"]}},
      "geometry": "Geometry.default",
      "materials": [{"*": "Material.default"}],
      "textures": ["Array.coats[q.is_baby ? 2 : (q.variant == 1 ? 1 : 0)]"],
      "part_visibility": [
        {"*": true},
        {
          "lids": "query.property('zoocraft:act') == 5 || math.mod(q.life_time + v.offset * 0.37, 4.7) < 0.15"
        }
      ]
    }
  }
}

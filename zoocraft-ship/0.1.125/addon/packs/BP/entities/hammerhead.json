{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "zoocraft:hammerhead",
      "spawn_category": "water_creature",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {"zoocraft:act": {"type": "int", "range": [0, 5], "default": 0, "client_sync": true}}
    },
    "component_groups": {
      "zoocraft:free": {
        "minecraft:behavior.random_swim": {
          "priority": 3,
          "interval": 0,
          "speed_multiplier": 1,
          "xz_dist": 16,
          "y_dist": 4,
          "avoid_surface": false
        },
        "minecraft:behavior.swim_wander": {"priority": 4, "interval": 0.1, "look_ahead": 4},
        "minecraft:behavior.swim_idle": {"priority": 5},
        "minecraft:behavior.move_towards_home_restriction": {"priority": 2, "speed_multiplier": 1.0}
      },
      "zoocraft:cruise": {
        "minecraft:timer": {
          "looping": false,
          "randomInterval": true,
          "time": [30, 70],
          "time_down_event": {"event": "zoocraft:show"}
        }
      },
      "zoocraft:showing": {
        "minecraft:timer": {
          "looping": false,
          "randomInterval": true,
          "time": [6, 10],
          "time_down_event": {"event": "zoocraft:cruise"}
        }
      },
      "zoocraft:home_4": {"minecraft:home": {"restriction_type": "random_movement", "restriction_radius": 4}},
      "zoocraft:home_8": {"minecraft:home": {"restriction_type": "random_movement", "restriction_radius": 8}},
      "zoocraft:home_16": {"minecraft:home": {"restriction_type": "random_movement", "restriction_radius": 16}},
      "zoocraft:home_32": {"minecraft:home": {"restriction_type": "random_movement", "restriction_radius": 32}}
    },
    "components": {
      "minecraft:type_family": {"family": ["zoocraft_animal", "hammerhead", "shark", "aquatic", "mob"]},
      "minecraft:nameable": {"always_show": false, "allow_name_tag_renaming": true},
      "minecraft:damage_sensor": {"triggers": [{"cause": "all", "deals_damage": "no"}]},
      "minecraft:persistent": {},
      "minecraft:behavior.tempt": {"priority": 3, "speed_multiplier": 1.1, "items": ["zoocraft:fish_ration"]},
      "minecraft:health": {"value": 30, "max": 30},
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": false,
        "breathes_water": true,
        "generates_bubbles": false
      },
      "minecraft:collision_box": {"width": 1.4, "height": 0.8},
      "minecraft:navigation.generic": {
        "can_breach": false,
        "can_walk": false,
        "can_path_over_water": false,
        "can_sink": false,
        "can_swim": true,
        "is_amphibious": false,
        "using_door_annotation": true
      },
      "minecraft:movement.basic": {},
      "minecraft:movement": {"value": 0.14},
      "minecraft:underwater_movement": {"value": 0.14},
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:behavior.look_at_player": {"priority": 9, "look_distance": 10, "probability": 0.02}
    },
    "events": {
      "zoocraft:show": {
        "remove": {"component_groups": ["zoocraft:cruise"]},
        "add": {"component_groups": ["zoocraft:showing"]},
        "set_property": {"zoocraft:act": 4}
      },
      "zoocraft:cruise": {
        "remove": {"component_groups": ["zoocraft:showing"]},
        "add": {"component_groups": ["zoocraft:cruise"]},
        "set_property": {"zoocraft:act": 0}
      },
      "zoocraft:hold": {"remove": {"component_groups": ["zoocraft:free", "zoocraft:cruise", "zoocraft:showing"]}},
      "zoocraft:free": {
        "add": {"component_groups": ["zoocraft:free", "zoocraft:cruise"]},
        "set_property": {"zoocraft:act": 0}
      },
      "zoocraft:home_4": {
        "remove": {"component_groups": ["zoocraft:home_8", "zoocraft:home_16", "zoocraft:home_32"]},
        "add": {"component_groups": ["zoocraft:home_4"]}
      },
      "zoocraft:home_8": {
        "remove": {"component_groups": ["zoocraft:home_4", "zoocraft:home_16", "zoocraft:home_32"]},
        "add": {"component_groups": ["zoocraft:home_8"]}
      },
      "zoocraft:home_16": {
        "remove": {"component_groups": ["zoocraft:home_4", "zoocraft:home_8", "zoocraft:home_32"]},
        "add": {"component_groups": ["zoocraft:home_16"]}
      },
      "zoocraft:home_32": {
        "remove": {"component_groups": ["zoocraft:home_4", "zoocraft:home_8", "zoocraft:home_16"]},
        "add": {"component_groups": ["zoocraft:home_32"]}
      },
      "minecraft:entity_spawned": {"add": {"component_groups": ["zoocraft:home_16", "zoocraft:free", "zoocraft:cruise"]}}
    }
  }
}

{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      "identifier": "zoocraft:croc_nest",
      "menu_category": {"category": "none"},
      "states": {"zoocraft:stage": [0, 1, 2], "zoocraft:red": [false, true]}
    },
    "components": {
      "minecraft:geometry": {
        "identifier": "geometry.zoocraft.croc_nest",
        "bone_visibility": {
          "flush": "query.block_state('zoocraft:stage') == 1",
          "dug": "query.block_state('zoocraft:stage') != 1",
          "eggs": "query.block_state('zoocraft:stage') == 0",
          "shells": "query.block_state('zoocraft:stage') == 2"
        }
      },
      "minecraft:material_instances": {
        "*": {"texture": "zoocraft_cnest_top", "render_method": "alpha_test"},
        "side": {"texture": "zoocraft_cnest_side", "render_method": "alpha_test"},
        "top": {"texture": "zoocraft_cnest_top", "render_method": "alpha_test"},
        "hole": {"texture": "zoocraft_cnest_hole", "render_method": "alpha_test"},
        "drag": {"texture": "zoocraft_cnest_drag", "render_method": "alpha_test"},
        "egg": {"texture": "zoocraft_cnest_egg", "render_method": "alpha_test"},
        "shell": {"texture": "zoocraft_cnest_shell", "render_method": "alpha_test"}
      },
      "minecraft:collision_box": true,
      "minecraft:selection_box": true,
      "minecraft:destructible_by_mining": {"seconds_to_destroy": 0.5},
      "minecraft:destructible_by_explosion": {"explosion_resistance": 1},
      "minecraft:map_color": "#dbcfa0",
      "minecraft:loot": "loot_tables/empty.json"
    },
    "permutations": [
      {
        "condition": "query.block_state('zoocraft:red')",
        "components": {
          "minecraft:material_instances": {
            "*": {"texture": "zoocraft_cnest_red_top", "render_method": "alpha_test"},
            "side": {"texture": "zoocraft_cnest_red_side", "render_method": "alpha_test"},
            "top": {"texture": "zoocraft_cnest_red_top", "render_method": "alpha_test"},
            "hole": {"texture": "zoocraft_cnest_red_hole", "render_method": "alpha_test"},
            "drag": {"texture": "zoocraft_cnest_red_drag", "render_method": "alpha_test"},
            "egg": {"texture": "zoocraft_cnest_egg", "render_method": "alpha_test"},
            "shell": {"texture": "zoocraft_cnest_shell", "render_method": "alpha_test"}
          },
          "minecraft:map_color": "#c26a2d"
        }
      }
    ]
  }
}

{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {"identifier": "zoocraft:wild_crocodile", "population_control": "animal"},
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": [
          "minecraft:grass_block",
          "minecraft:mud",
          "minecraft:muddy_mangrove_roots",
          "minecraft:dirt",
          "minecraft:clay",
          "minecraft:sand"
        ],
        "minecraft:brightness_filter": {"min": 7, "max": 15, "adjust_for_weather": false},
        "minecraft:weight": {"default": 2},
        "minecraft:herd": {"min_size": 1, "max_size": 2},
        "minecraft:density_limit": {"surface": 3},
        "minecraft:biome_filter": {
          "any_of": [
            {"test": "has_biome_tag", "value": "swamp"},
            {"test": "has_biome_tag", "value": "mangrove_swamp"}
          ]
        }
      }
    ]
  }
}

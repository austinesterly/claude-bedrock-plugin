      "render_controllers": ["controller.render.zoocraft.crocodile"],
      "scripts": {
        "scale": "(q.is_baby ? 0.05 * (1 + q.property('zoocraft:grow')) : (q.mark_variant == 1 ? 0.655 : 0.5) * (1 + 0.04 * (q.property('zoocraft:size') - 2)))",
        "initialize": [
          "v.offset = math.random(0, 24);",
          "v.st = 0;",
          "v.gait = 0;",
          "v.posture = 0;",
          "v.leg_rate = 1;"
        ],
        "pre_animation": [
          "v.act = q.property('zoocraft:act');",
          "v.posture = (v.act == 5 || v.act == 6 || v.act == 7 || v.act == 13 || v.act == 19 || v.act == 20 || v.act == 26 || v.act == 9) ? 1 : (((v.act == 4 || v.act == 8 || v.act == 10 || v.act == 16 || v.act == 17 || v.act == 18 || v.act == 23 || v.act == 27 || v.act == 29 || v.act == 30 || v.act == 31) || (v.act == 0 && q.is_in_water && !q.is_on_ground)) ? 2 : 0);",
          "v.gait = q.modified_move_speed <= 0.02 ? 0 : 1;",
          "v.leg_rate = math.sqrt(0.5 / (q.is_baby ? 0.05 * (1 + q.property('zoocraft:grow')) : (q.mark_variant == 1 ? 0.655 : 0.5) * (1 + 0.04 * (q.property('zoocraft:size') - 2))));"
        ],
        "animate": ["move", {"young": "q.is_baby"}, {"male": "!q.is_baby && q.mark_variant == 1"}]
      }
    }

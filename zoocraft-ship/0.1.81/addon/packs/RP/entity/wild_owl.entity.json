        "pellet": "animation.zoocraft.owl.pellet",
        "preen": "animation.zoocraft.owl.preen",
        "display": "animation.zoocraft.owl.display",
        "nestbox": "animation.zoocraft.owl.nestbox",
        "beg": "animation.zoocraft.owl.beg",
        "look_at_target": "animation.zoocraft.owl.look_at_target",
        "move": "controller.animation.zoocraft.owl.move"
      },
      "render_controllers": ["controller.render.zoocraft.owl"],

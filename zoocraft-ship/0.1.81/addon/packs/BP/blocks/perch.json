        "components": {
          "minecraft:transformation": {"rotation": [0, 90, 0]},
          "minecraft:collision_box": {"origin": [-1.5, 13, -7], "size": [3, 3, 14]},
          "minecraft:selection_box": {"origin": [-4, 0, -7], "size": [8, 16, 14]}

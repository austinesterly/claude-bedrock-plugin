{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {"identifier": "zoocraft:wild_deer", "population_control": "animal"},
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": ["minecraft:grass_block", "minecraft:podzol", "minecraft:coarse_dirt"],
        "minecraft:brightness_filter": {"min": 7, "max": 15, "adjust_for_weather": false},
        "minecraft:weight": {"default": 30},
        "minecraft:herd": {"min_size": 2, "max_size": 4},
        "minecraft:biome_filter": {
          "any_of": [
            {"test": "has_biome_tag", "value": "forest"},
            {"test": "has_biome_tag", "value": "taiga"},
            {"test": "has_biome_tag", "value": "meadow"},
            {"test": "has_biome_tag", "value": "plains"}
          ]
        }
      }
    ]
  }
}

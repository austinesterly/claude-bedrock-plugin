{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {"identifier": "zoocraft:wild_capybara", "population_control": "animal"},
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:brightness_filter": {"min": 7, "max": 15, "adjust_for_weather": false},
        "minecraft:weight": {"default": 20},
        "minecraft:herd": {"min_size": 2, "max_size": 4},
        "minecraft:biome_filter": {
          "any_of": [
            {"test": "has_biome_tag", "value": "swamp"},
            {"test": "has_biome_tag", "value": "mangrove_swamp"},
            {"test": "has_biome_tag", "value": "jungle"}
          ]
        }
      }
    ]
  }
}

{
  "format_version": "1.8.0",
  "animations": {
    "animation.zoocraft.sloth.walk": {
      "loop": true,
      "bones": {
        "leg0": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 80) * 28",
            0,
            0
          ]
        },
        "leg3": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 80) * 28",
            0,
            0
          ]
        },
        "leg1": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 80) * 28",
            0,
            0
          ]
        },
        "leg2": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 80) * 28",
            0,
            0
          ]
        },
        "body": {
          "rotation": [
            0,
            0,
            "math.sin(query.modified_distance_moved * 80) * 3"
          ]
        }
      }
    },
    "animation.zoocraft.sloth.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "math.clamp(query.target_x_rotation, -20, 20) + math.sin(query.life_time * 40) * 3",
            "math.clamp(query.target_y_rotation, -40, 40)",
            0
          ]
        }
      }
    }
  }
}

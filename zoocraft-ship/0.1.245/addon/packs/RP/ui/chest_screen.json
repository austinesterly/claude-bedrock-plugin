{
  "namespace": "chest",
  "zoocraft_disposery_background@common.dialog_background_opaque": {
    "texture": "textures/ui/zoocraft/disposery/dialog"
  },
  "small_chest_screen": {
    "$zoocraft_title|default": "$container_title",
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": [
          {
            "requires": "($zoocraft_title = 'entity.zoocraft:disposery_store.name')",
            "$dialog_background": "chest.zoocraft_disposery_background"
          }
        ]
      }
    ]
  }
}

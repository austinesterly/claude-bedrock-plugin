{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.zoocraft.cinder_boar": {
      "arrays": {
        "textures": {
          "Array.skins": [
            "Texture.default",
            "Texture.sleep",
            "Texture.mud",
            "Texture.mud_sleep",
            "Texture.piglet",
            "Texture.piglet_sleep",
            "Texture.piglet_mud",
            "Texture.piglet_mud_sleep"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [{"*": "Material.default"}],
      "textures": [
        "Array.skins[(query.is_baby ? 4 : 0) + (query.property('zoocraft:muddy') ? 2 : 0) + ((query.property('zoocraft:act') == 5) ? 1 : 0)]"
      ],
      "part_visibility": [{"*": true}, {"tusks": "!query.is_baby && query.mark_variant == 1"}]
    }
  }
}

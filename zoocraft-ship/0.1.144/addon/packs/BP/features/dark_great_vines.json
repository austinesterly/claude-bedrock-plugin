{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "zoocraft:dark_great_vines"
    },
    "acacia_trunk": {
      "trunk_width": 2,
      "trunk_height": {
        "base": 8,
        "intervals": [
          3,
          3
        ]
      },
      "trunk_block": {
        "name": "minecraft:dark_oak_log"
      },
      "trunk_lean": {
        "allow_diagonal_growth": true,
        "lean_height": {
          "range_min": 3,
          "range_max": 5
        },
        "lean_steps": {
          "range_min": 0,
          "range_max": 2
        },
        "lean_length": {
          "range_min": 1,
          "range_max": 2
        }
      },
      "branches": {
        "branch_chance": {
          "numerator": 1,
          "denominator": 1
        },
        "branch_length": {
          "range_min": 3,
          "range_max": 5
        },
        "branch_position": {
          "range_min": 2,
          "range_max": 5
        },
        "branch_canopy": {
          "acacia_canopy": {
            "canopy_size": 2,
            "leaf_block": {
              "name": "minecraft:dark_oak_leaves"
            },
            "simplify_canopy": true
          }
        }
      },
      "trunk_decoration": {
        "decoration_block": "minecraft:vine",
        "decoration_chance": {
          "numerator": 6,
          "denominator": 7
        }
      }
    },
    "roofed_canopy": {
      "canopy_height": 4,
      "core_width": 2,
      "outer_radius": 2,
      "inner_radius": 3,
      "leaf_block": {
        "name": "minecraft:dark_oak_leaves"
      }
    },
    "may_grow_on": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "base_block": [
      "minecraft:dirt",
      "minecraft:coarse_dirt"
    ],
    "may_grow_through": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "may_replace": [
      "minecraft:air",
      "minecraft:snow_layer",
      {
        "tags": "query.any_tag('minecraft:leaves')"
      },
      "minecraft:wildflowers",
      "minecraft:leaf_litter",
      "minecraft:short_grass",
      "minecraft:tall_grass",
      "minecraft:fern",
      "minecraft:large_fern"
    ]
  }
}

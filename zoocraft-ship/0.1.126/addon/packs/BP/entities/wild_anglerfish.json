{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "zoocraft:wild_anglerfish",
      "spawn_category": "water_creature",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {"zoocraft:luring": {"type": "bool", "default": false, "client_sync": true}}
    },
    "component_groups": {
      "zoocraft:free": {
        "minecraft:behavior.random_swim": {
          "priority": 3,
          "interval": 0,
          "speed_multiplier": 1,
          "xz_dist": 5,
          "y_dist": 2,
          "avoid_surface": true
        },
        "minecraft:behavior.swim_idle": {"priority": 5}
      },
      "zoocraft:cruise": {
        "minecraft:timer": {
          "looping": false,
          "randomInterval": true,
          "time": [20, 45],
          "time_down_event": {"event": "zoocraft:lure"}
        }
      },
      "zoocraft:luring": {
        "minecraft:timer": {
          "looping": false,
          "randomInterval": true,
          "time": [3, 5],
          "time_down_event": {"event": "zoocraft:cruise"}
        }
      }
    },
    "components": {
      "minecraft:type_family": {"family": ["wild_anglerfish", "anglerfish", "aquatic", "mob"]},
      "minecraft:nameable": {},
      "minecraft:despawn": {"despawn_from_distance": {}},
      "minecraft:behavior.tempt": {"priority": 3, "speed_multiplier": 1.2, "items": ["zoocraft:fish_ration"]},
      "minecraft:health": {"value": 6, "max": 6},
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": false,
        "breathes_water": true,
        "generates_bubbles": false
      },
      "minecraft:collision_box": {"width": 0.7, "height": 0.7},
      "minecraft:navigation.generic": {
        "can_breach": false,
        "can_walk": false,
        "can_path_over_water": false,
        "can_sink": false,
        "can_swim": true,
        "is_amphibious": false,
        "using_door_annotation": true
      },
      "minecraft:movement.basic": {},
      "minecraft:movement": {"value": 0.03},
      "minecraft:underwater_movement": {"value": 0.03},
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:conditional_bandwidth_optimization": {}
    },
    "events": {
      "zoocraft:lure": {
        "remove": {"component_groups": ["zoocraft:cruise"]},
        "add": {"component_groups": ["zoocraft:luring"]},
        "set_property": {"zoocraft:luring": true}
      },
      "zoocraft:cruise": {
        "remove": {"component_groups": ["zoocraft:luring"]},
        "add": {"component_groups": ["zoocraft:cruise"]},
        "set_property": {"zoocraft:luring": false}
      },
      "minecraft:entity_spawned": {"add": {"component_groups": ["zoocraft:free", "zoocraft:cruise"]}}
    }
  }
}

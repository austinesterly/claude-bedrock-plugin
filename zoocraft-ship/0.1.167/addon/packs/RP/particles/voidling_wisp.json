{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "zoocraft:voidling_wisp",
      "basic_render_parameters": {"material": "particles_alpha", "texture": "textures/particle/particles"}
    },
    "components": {
      "minecraft:emitter_rate_instant": {"num_particles": 14},
      "minecraft:emitter_lifetime_once": {"active_time": 0.05},
      "minecraft:emitter_shape_sphere": {"radius": 0.6, "direction": [0, 1, 0]},
      "minecraft:particle_lifetime_expression": {"max_lifetime": "1.2 + variable.particle_random_3 * 0.6"},
      "minecraft:particle_initial_speed": "0.8 * (0.6 + variable.particle_random_1 * 0.6)",
      "minecraft:particle_motion_dynamic": {"linear_acceleration": [0, 0.5, 0], "linear_drag_coefficient": 1.2},
      "minecraft:particle_appearance_billboard": {
        "size": ["0.16 + variable.particle_age * 0.16", "0.16 + variable.particle_age * 0.16"],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [56, 0],
            "size_UV": [8, 8],
            "step_UV": [-8, 0],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.72,
          0.42,
          1.0,
          "math.clamp((variable.particle_lifetime - variable.particle_age) * 1.5, 0, 0.9)"
        ]
      }
    }
  }
}

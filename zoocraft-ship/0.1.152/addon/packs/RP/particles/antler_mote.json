{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "zoocraft:antler_mote",
      "basic_render_parameters": {"material": "particles_blend", "texture": "textures/particle/particles"}
    },
    "components": {
      "minecraft:emitter_rate_instant": {"num_particles": 1},
      "minecraft:emitter_lifetime_once": {"active_time": 0.05},
      "minecraft:emitter_shape_point": {"offset": [0, 0, 0], "direction": ["math.random(-0.3, 0.3)", 1, "math.random(-0.3, 0.3)"]},
      "minecraft:particle_lifetime_expression": {"max_lifetime": "1.6 + variable.particle_random_3 * 1.2"},
      "minecraft:particle_initial_speed": 0.5,
      "minecraft:particle_motion_dynamic": {"linear_acceleration": [0, 0.25, 0], "linear_drag_coefficient": 1.2},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.06 + 0.04 * math.abs(math.sin(variable.particle_age * 200 + variable.particle_random_1 * 360))",
          "0.06 + 0.04 * math.abs(math.sin(variable.particle_age * 200 + variable.particle_random_1 * 360))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {"texture_width": 128, "texture_height": 128, "uv": [56, 0], "uv_size": [8, 8]}
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.particle_random_2 < 0.5 ? 0.65 : 0.37",
          "variable.particle_random_2 < 0.5 ? 0.95 : 0.89",
          "variable.particle_random_2 < 0.5 ? 0.83 : 0.92",
          "math.clamp((variable.particle_lifetime - variable.particle_age) * 1.5, 0, 1)"
        ]
      }
    }
  }
}

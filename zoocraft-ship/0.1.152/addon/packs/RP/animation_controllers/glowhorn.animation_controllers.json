{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.zoocraft.glowhorn.move": {
      "initial_state": "start",
      "states": {
        "start": {"transitions": [{"lie": "v.act == 5"}, {"idle": "v.act != 5"}], "blend_transition": 0},
        "idle": {
          "animations": ["idle", "look_at_target"],
          "transitions": [
            {"lie_down": "v.act == 5"},
            {"walking": "v.act == 0 && v.moving"},
            {"graze": "v.act == 1"},
            {"bellow": "v.act == 2"},
            {"rub": "v.act == 3"},
            {"alert": "v.act == 4"},
            {"glow": "v.act == 6"},
            {"step": "v.act == 7"},
            {"back": "v.act == 8"}
          ],
          "blend_transition": 0.3
        },
        "walking": {
          "animations": ["walk", "look_at_target"],
          "transitions": [
            {"lie_down": "v.act == 5"},
            {"idle": "v.act == 0 && !v.moving"},
            {"graze": "v.act == 1"},
            {"bellow": "v.act == 2"},
            {"rub": "v.act == 3"},
            {"alert": "v.act == 4"},
            {"glow": "v.act == 6"},
            {"step": "v.act == 7"},
            {"back": "v.act == 8"}
          ],
          "blend_transition": 0.25
        },
        "graze": {
          "animations": ["graze"],
          "transitions": [
            {"lie_down": "v.act == 5"},
            {"idle": "v.act == 0 && !v.moving"},
            {"walking": "v.act == 0 && v.moving"},
            {"bellow": "v.act == 2"},
            {"rub": "v.act == 3"},
            {"alert": "v.act == 4"},
            {"glow": "v.act == 6"},
            {"step": "v.act == 7"},
            {"back": "v.act == 8"}
          ],
          "blend_transition": 0.45
        },
        "bellow": {
          "animations": ["bellow"],
          "transitions": [
            {"lie_down": "v.act == 5"},
            {"idle": "v.act == 0 && !v.moving"},
            {"walking": "v.act == 0 && v.moving"},
            {"graze": "v.act == 1"},
            {"rub": "v.act == 3"},
            {"alert": "v.act == 4"},
            {"glow": "v.act == 6"},
            {"step": "v.act == 7"},
            {"back": "v.act == 8"}
          ],
          "blend_transition": 0.25
        },
        "rub": {
          "animations": ["rub"],
          "transitions": [
            {"lie_down": "v.act == 5"},
            {"idle": "v.act == 0 && !v.moving"},
            {"walking": "v.act == 0 && v.moving"},
            {"graze": "v.act == 1"},
            {"bellow": "v.act == 2"},
            {"alert": "v.act == 4"},
            {"glow": "v.act == 6"},
            {"step": "v.act == 7"},
            {"back": "v.act == 8"}
          ],
          "blend_transition": 0.45
        },
        "alert": {
          "animations": ["alert", "look_at_target"],
          "transitions": [
            {"lie_down": "v.act == 5"},
            {"idle": "v.act == 0 && !v.moving"},
            {"walking": "v.act == 0 && v.moving"},
            {"graze": "v.act == 1"},
            {"bellow": "v.act == 2"},
            {"rub": "v.act == 3"},
            {"glow": "v.act == 6"},
            {"step": "v.act == 7"},
            {"back": "v.act == 8"}
          ],
          "blend_transition": 0.45
        },
        "glow": {
          "animations": ["glow"],
          "transitions": [
            {"lie_down": "v.act == 5"},
            {"idle": "v.act == 0 && !v.moving"},
            {"walking": "v.act == 0 && v.moving"},
            {"graze": "v.act == 1"},
            {"bellow": "v.act == 2"},
            {"rub": "v.act == 3"},
            {"alert": "v.act == 4"},
            {"step": "v.act == 7"},
            {"back": "v.act == 8"}
          ],
          "blend_transition": 0.45
        },
        "step": {
          "animations": ["step"],
          "transitions": [
            {"lie_down": "v.act == 5"},
            {"idle": "v.act == 0 && !v.moving"},
            {"walking": "v.act == 0 && v.moving"},
            {"graze": "v.act == 1"},
            {"bellow": "v.act == 2"},
            {"rub": "v.act == 3"},
            {"alert": "v.act == 4"},
            {"glow": "v.act == 6"},
            {"back": "v.act == 8"}
          ],
          "blend_transition": 0.25
        },
        "back": {
          "animations": ["back"],
          "transitions": [
            {"lie_down": "v.act == 5"},
            {"idle": "v.act == 0 && !v.moving"},
            {"walking": "v.act == 0 && v.moving"},
            {"graze": "v.act == 1"},
            {"bellow": "v.act == 2"},
            {"rub": "v.act == 3"},
            {"alert": "v.act == 4"},
            {"glow": "v.act == 6"},
            {"step": "v.act == 7"}
          ],
          "blend_transition": 0.25
        },
        "lie_down": {
          "animations": ["lie_down", "down_life"],
          "blend_transition": 0,
          "on_entry": ["v.st = q.life_time;"],
          "transitions": [
            {"lie": "(q.life_time - v.st) > 2.0 && v.act == 5"},
            {"get_up": "(q.life_time - v.st) > 2.0 && v.act != 5"}
          ]
        },
        "lie": {
          "animations": ["lie", "down_life"],
          "blend_transition": 0,
          "transitions": [{"get_up": "v.act != 5"}]
        },
        "get_up": {
          "animations": ["get_up"],
          "blend_transition": 0.2,
          "on_entry": ["v.st = q.life_time;"],
          "transitions": [
            {"lie_down": "v.act == 5 && (q.life_time - v.st) > 1.2"},
            {"idle": "v.act == 0 && !v.moving && (q.life_time - v.st) > 1.2"},
            {"walking": "v.act == 0 && v.moving && (q.life_time - v.st) > 1.2"},
            {"graze": "v.act == 1 && (q.life_time - v.st) > 1.2"},
            {"bellow": "v.act == 2 && (q.life_time - v.st) > 1.2"},
            {"rub": "v.act == 3 && (q.life_time - v.st) > 1.2"},
            {"alert": "v.act == 4 && (q.life_time - v.st) > 1.2"},
            {"glow": "v.act == 6 && (q.life_time - v.st) > 1.2"},
            {"step": "v.act == 7 && (q.life_time - v.st) > 1.2"},
            {"back": "v.act == 8 && (q.life_time - v.st) > 1.2"}
          ]
        }
      }
    }
  }
}

{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "zoocraft:azalea_round"
    },
    "acacia_trunk": {
      "trunk_width": 1,
      "trunk_height": {
        "base": 4,
        "intervals": [
          1,
          1
        ]
      },
      "trunk_block": {
        "name": "minecraft:oak_log"
      },
      "trunk_lean": {
        "allow_diagonal_growth": true,
        "lean_height": {
          "range_min": 1,
          "range_max": 2
        },
        "lean_steps": {
          "range_min": 0,
          "range_max": 1
        },
        "lean_length": {
          "range_min": 0,
          "range_max": 1
        }
      }
    },
    "cherry_canopy": {
      "leaf_block": {
        "name": "minecraft:azalea_leaves"
      },
      "height": 4,
      "radius": {
        "range_min": 3,
        "range_max": 3
      },
      "wide_bottom_layer_hole_chance": 50,
      "corner_hole_chance": 100,
      "hanging_leaves_chance": 0,
      "hanging_leaves_extension_chance": 0
    },
    "may_grow_on": [

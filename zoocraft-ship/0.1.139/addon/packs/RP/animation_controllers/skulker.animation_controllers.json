{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.zoocraft.skulker.move": {
      "initial_state": "start",
      "states": {
        "start": {
          "transitions": [{"sit": "v.act == 4"}, {"buried": "v.act == 5"}, {"idle": "v.act != 4 && v.act != 5"}],
          "blend_transition": 0
        },
        "idle": {
          "animations": ["idle", "look_at_target"],
          "transitions": [
            {"sit_down": "v.act == 4"},
            {"dig_down": "v.act == 5"},
            {"walking": "v.act == 0 && v.moving"},
            {"listen": "v.act == 1"},
            {"sniff": "v.act == 2"},
            {"feed": "v.act == 3"}
          ],
          "blend_transition": 0.3
        },
        "walking": {
          "animations": ["walk", "look_at_target"],
          "transitions": [
            {"sit_down": "v.act == 4"},
            {"dig_down": "v.act == 5"},
            {"idle": "v.act == 0 && !v.moving"},
            {"listen": "v.act == 1"},
            {"sniff": "v.act == 2"},
            {"feed": "v.act == 3"}
          ],
          "blend_transition": 0.25
        },
        "listen": {
          "animations": ["listen", "look_at_target"],
          "transitions": [
            {"sit_down": "v.act == 4"},
            {"dig_down": "v.act == 5"},
            {"idle": "v.act == 0 && !v.moving"},
            {"walking": "v.act == 0 && v.moving"},
            {"sniff": "v.act == 2"},
            {"feed": "v.act == 3"}
          ],
          "blend_transition": 0.3
        },
        "sniff": {
          "animations": ["sniff"],
          "transitions": [
            {"sit_down": "v.act == 4"},
            {"dig_down": "v.act == 5"},
            {"idle": "v.act == 0 && !v.moving"},
            {"walking": "v.act == 0 && v.moving"},
            {"listen": "v.act == 1"},
            {"feed": "v.act == 3"}
          ],
          "blend_transition": 0.3
        },
        "feed": {
          "animations": ["feed"],
          "transitions": [
            {"sit_down": "v.act == 4"},
            {"dig_down": "v.act == 5"},
            {"idle": "v.act == 0 && !v.moving"},
            {"walking": "v.act == 0 && v.moving"},
            {"listen": "v.act == 1"},
            {"sniff": "v.act == 2"}
          ],
          "blend_transition": 0.3
        },
        "sit_down": {
          "animations": ["sit_down"],
          "blend_transition": 0.15,
          "on_entry": ["v.st = q.life_time;"],
          "transitions": [
            {"sit": "(q.life_time - v.st) > 1 && v.act == 4"},
            {"sit_up": "(q.life_time - v.st) > 1 && v.act != 4"}
          ]
        },
        "sit": {"animations": ["sit"], "blend_transition": 0, "transitions": [{"sit_up": "v.act != 4"}]},
        "sit_up": {
          "animations": ["sit_up"],
          "blend_transition": 0,
          "on_entry": ["v.st = q.life_time;"],
          "transitions": [
            {"sit_down": "v.act == 4 && (q.life_time - v.st) > 0.8"},
            {"dig_down": "v.act == 5 && (q.life_time - v.st) > 0.8"},
            {"idle": "v.act == 0 && !v.moving && (q.life_time - v.st) > 0.8"},
            {"walking": "v.act == 0 && v.moving && (q.life_time - v.st) > 0.8"},
            {"listen": "v.act == 1 && (q.life_time - v.st) > 0.8"},
            {"sniff": "v.act == 2 && (q.life_time - v.st) > 0.8"},
            {"feed": "v.act == 3 && (q.life_time - v.st) > 0.8"}
          ]
        },
        "dig_down": {
          "animations": ["dig_down"],
          "blend_transition": 0.15,
          "on_entry": ["v.st = q.life_time;"],
          "transitions": [
            {"buried": "(q.life_time - v.st) > 2.5 && v.act == 5"},
            {"emerge": "(q.life_time - v.st) > 2.5 && v.act != 5"}
          ]
        },
        "buried": {"animations": ["buried"], "blend_transition": 0, "transitions": [{"emerge": "v.act != 5"}]},
        "emerge": {
          "animations": ["emerge"],
          "blend_transition": 0,
          "on_entry": ["v.st = q.life_time;"],
          "transitions": [
            {"sit_down": "v.act == 4 && (q.life_time - v.st) > 2.5"},
            {"dig_down": "v.act == 5 && (q.life_time - v.st) > 2.5"},
            {"idle": "v.act == 0 && !v.moving && (q.life_time - v.st) > 2.5"},
            {"walking": "v.act == 0 && v.moving && (q.life_time - v.st) > 2.5"},
            {"listen": "v.act == 1 && (q.life_time - v.st) > 2.5"},
            {"sniff": "v.act == 2 && (q.life_time - v.st) > 2.5"},
            {"feed": "v.act == 3 && (q.life_time - v.st) > 2.5"}
          ]
        }
      }
    }
  }
}

{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "zoocraft:glade_mote",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          "math.random(-0.3, 0.3)",
          1,
          "math.random(-0.3, 0.3)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "4 + variable.particle_random_3 * 3"
      },
      "minecraft:particle_initial_speed": 0.12,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 90 + variable.particle_random_1 * 360) * 0.12",
          0.015,
          "math.cos(variable.particle_age * 90 + variable.particle_random_2 * 360) * 0.12"
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.045 + 0.02 * math.sin(variable.particle_age * 160)",
          "0.045 + 0.02 * math.sin(variable.particle_age * 160)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            56,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.particle_random_2 < 0.4 ? 1.0 : (variable.particle_random_2 < 0.75 ? 0.62 : 1.0)",
          "variable.particle_random_2 < 0.4 ? 0.72 : (variable.particle_random_2 < 0.75 ? 0.98 : 0.92)",
          "variable.particle_random_2 < 0.4 ? 0.9 : (variable.particle_random_2 < 0.75 ? 0.9 : 0.55)",
          "math.clamp(math.min(variable.particle_age, variable.particle_lifetime - variable.particle_age), 0, 0.85)"
        ]
      }
    }
  }
}

{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      "identifier": "zoocraft:mythwood_log",
      "menu_category": {
        "category": "nature"
      },
      "traits": {
        "minecraft:placement_position": {
          "enabled_states": [
            "minecraft:block_face"
          ]
        }
      }
    },
    "components": {
      "minecraft:geometry": "minecraft:geometry.full_block",
      "minecraft:material_instances": {
        "*": {
          "texture": "zoocraft_mythwood_log_side",
          "render_method": "opaque"
        },
        "up": {
          "texture": "zoocraft_mythwood_log_top",
          "render_method": "opaque"
        },
        "down": {
          "texture": "zoocraft_mythwood_log_top",
          "render_method": "opaque"
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 2.0
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 2
      },
      "minecraft:flammable": {
        "catch_chance_modifier": 5,
        "destroy_chance_modifier": 5
      },
      "minecraft:tags": [
        "minecraft:is_hatchet_item_destructible",
        "wood",
        "log"
      ],
      "minecraft:map_color": "#cfc4dd",
      "minecraft:loot": "loot_tables/blocks/zoocraft_mythwood_log.json"
    },
    "permutations": [
      {
        "condition": "query.block_state('minecraft:block_face') == 'north' || query.block_state('minecraft:block_face') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              90,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('minecraft:block_face') == 'east' || query.block_state('minecraft:block_face') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              90
            ]
          }
        }
      }
    ]
  }
}

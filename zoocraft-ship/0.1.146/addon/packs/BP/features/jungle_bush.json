{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "zoocraft:jungle_bush"
    },
    "trunk": {
      "trunk_height": 1,
      "trunk_block": {
        "name": "minecraft:jungle_log"
      }
    },
    "canopy": {
      "canopy_offset": {
        "min": -1,
        "max": 1
      },
      "min_width": 0,
      "canopy_slope": {
        "rise": 1,
        "run": 1
      },
      "variation_chance": {
        "numerator": 1,
        "denominator": 2
      },
      "leaf_block": {
        "name": "minecraft:oak_leaves"
      }
    },
    "may_grow_on": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "base_block": [
      "minecraft:dirt",
      "minecraft:coarse_dirt"
    ],
    "may_grow_through": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "may_replace": [
      "minecraft:air",
      {
        "tags": "query.any_tag('minecraft:leaves')"
      },
      "minecraft:short_grass",
      "minecraft:tall_grass",
      "minecraft:fern",
      "minecraft:large_fern",
      "minecraft:vine"
    ]
  }
}

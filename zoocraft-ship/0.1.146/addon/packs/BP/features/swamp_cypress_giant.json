{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "zoocraft:swamp_cypress_giant"
    },
    "mega_trunk": {
      "trunk_width": 2,
      "trunk_height": {
        "base": 12,
        "intervals": [
          3
        ]
      },
      "trunk_block": {
        "name": "minecraft:oak_log"
      },
      "trunk_decoration": {
        "decoration_block": "minecraft:vine",
        "decoration_chance": {
          "numerator": 1,
          "denominator": 4
        }
      },
      "branches": {
        "branch_length": 2,
        "branch_slope": 0.6,
        "branch_interval": {
          "range_min": 2,
          "range_max": 3
        },
        "branch_altitude_factor": {
          "min": 0.6,
          "max": 1.0
        },
        "branch_canopy": {
          "mega_canopy": {
            "canopy_height": {
              "range_min": 2,
              "range_max": 2
            },
            "base_radius": 1,
            "simplify_canopy": true,
            "leaf_block": {
              "name": "minecraft:oak_leaves"
            }
          }
        }
      }
    },
    "mega_canopy": {
      "canopy_height": 2,
      "base_radius": 2,
      "core_width": 2,
      "simplify_canopy": true,
      "leaf_block": {
        "name": "minecraft:oak_leaves"
      }
    },
    "may_grow_on": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "base_block": [
      "minecraft:dirt",
      "minecraft:coarse_dirt"
    ],
    "may_grow_through": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "may_replace": [
      "minecraft:air",
      {
        "tags": "query.any_tag('minecraft:leaves')"
      },
      "minecraft:short_grass",
      "minecraft:tall_grass",
      "minecraft:fern",
      "minecraft:large_fern",
      "minecraft:vine",
      "minecraft:water"
    ]
  }
}

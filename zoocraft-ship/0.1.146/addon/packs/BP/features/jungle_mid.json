{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "zoocraft:jungle_mid"
    },
    "mega_trunk": {
      "trunk_width": 1,
      "trunk_height": {
        "base": 8,
        "intervals": [
          3
        ]
      },
      "trunk_block": {
        "name": "minecraft:jungle_log"
      },
      "trunk_decoration": {
        "decoration_block": "minecraft:vine",
        "decoration_chance": {
          "numerator": 1,
          "denominator": 3
        }
      }
    },
    "mega_canopy": {
      "canopy_height": 3,
      "base_radius": 2,
      "core_width": 1,
      "simplify_canopy": true,
      "leaf_block": {
        "name": "minecraft:jungle_leaves"
      }
    },
    "may_grow_on": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "base_block": [
      "minecraft:dirt",
      "minecraft:coarse_dirt"
    ],
    "may_grow_through": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "may_replace": [
      "minecraft:air",
      {
        "tags": "query.any_tag('minecraft:leaves')"
      },
      "minecraft:short_grass",
      "minecraft:tall_grass",
      "minecraft:fern",
      "minecraft:large_fern",
      "minecraft:vine"
    ]
  }
}

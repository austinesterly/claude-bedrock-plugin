          "v.rip = (v.rip ?? 0) + ((v.act == 5 ? 1 : 0) - (v.rip ?? 0)) * math.min(1, v.dt * 6);",
          "v.aim = (v.aim ?? 0) + ((v.act == 6 ? 1 : 0) - (v.aim ?? 0)) * math.min(1, v.dt * 7);",
          "v.throw = (v.throw ?? 0) + ((v.act == 7 ? 1 : 0) - (v.throw ?? 0)) * math.min(1, v.dt * 16);",

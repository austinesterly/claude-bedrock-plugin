{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.zoocraft.shulker_peek": {
      "initial_state": "start",
      "states": {
        "start": {
          "on_entry": [
            "variable.peek_goal = 0.0;",
            "variable.peek_at = query.life_time + math.random(4.0, 14.0);"
          ],
          "transitions": [
            {
              "peek": "query.life_time >= variable.peek_at"
            }
          ]
        },
        "peek": {
          "on_entry": [
            "variable.peek_goal = 0.3;",
            "variable.peek_end = query.life_time + math.random(1.0, 3.0);"
          ],
          "sound_effects": [
            {
              "effect": "open"
            }
          ],
          "transitions": [
            {
              "shut": "query.life_time >= variable.peek_end"
            }
          ]
        },
        "shut": {
          "on_entry": [
            "variable.peek_goal = 0.0;",
            "variable.peek_at = query.life_time + math.random(4.0, 14.0);"
          ],
          "sound_effects": [
            {
              "effect": "close"
            }
          ],
          "transitions": [
            {
              "peek": "query.life_time >= variable.peek_at"
            }
          ]
        }
      }
    }
  }
}

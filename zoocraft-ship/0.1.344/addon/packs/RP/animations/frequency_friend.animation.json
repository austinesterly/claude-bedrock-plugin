{
  "format_version": "1.8.0",
  "animations": {
    "animation.zoocraft.frequency_friend.hum": {
      "loop": true,
      "bones": {
        "body": {
          "position": [
            0,
            "math.sin(query.life_time * 120.0) * 0.5",
            0
          ]
        },
        "right_arm": {
          "rotation": [
            "math.sin(query.life_time * 90.0) * 8.0",
            0,
            0
          ]
        },
        "left_arm": {
          "rotation": [
            "-math.sin(query.life_time * 90.0) * 8.0",
            0,
            0
          ]
        },
        "tip": {
          "scale": "1.0 + math.sin(query.life_time * 240.0) * 0.15"
        }
      }
    },
    "animation.zoocraft.frequency_friend.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.zoocraft.frequency_friend.walk": {
      "loop": true,
      "bones": {
        "right_leg": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 40.0 * query.modified_move_speed",
            0,
            0
          ]
        },
        "left_leg": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 40.0 * query.modified_move_speed",
            0,
            0
          ]
        }
      }
    }
  }
}

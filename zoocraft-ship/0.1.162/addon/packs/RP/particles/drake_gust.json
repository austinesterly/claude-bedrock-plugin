{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "zoocraft:drake_gust",
      "basic_render_parameters": {"material": "particles_alpha", "texture": "textures/particle/particles"}
    },
    "components": {
      "minecraft:emitter_rate_instant": {"num_particles": 46},
      "minecraft:emitter_lifetime_once": {"active_time": 0.05},
      "minecraft:emitter_shape_disc": {
        "radius": 2.2,
        "plane_normal": ["variable.dx", 0, "variable.dz"],
        "direction": [
          "variable.dx * 3 + math.random(-0.6, 0.6)",
          "math.random(-0.4, 0.2)",
          "variable.dz * 3 + math.random(-0.6, 0.6)"
        ]
      },
      "minecraft:particle_lifetime_expression": {"max_lifetime": "0.7 + variable.particle_random_3 * 0.4"},
      "minecraft:particle_initial_speed": "9 * (0.6 + variable.particle_random_1 * 0.6)",
      "minecraft:particle_motion_dynamic": {"linear_acceleration": [0, -0.5, 0], "linear_drag_coefficient": 2.5},
      "minecraft:particle_appearance_billboard": {
        "size": ["0.22 + variable.particle_age * 0.4", "0.22 + variable.particle_age * 0.4"],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [56, 0],
            "size_UV": [8, 8],
            "step_UV": [-8, 0],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.82,
          0.8,
          0.86,
          "math.clamp((variable.particle_lifetime - variable.particle_age) * 1.4, 0, 0.75)"
        ]
      }
    }
  }
}

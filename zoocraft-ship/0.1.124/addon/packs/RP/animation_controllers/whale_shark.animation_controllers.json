{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.zoocraft.whale_shark.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [{"swimming": "query.modified_move_speed > 0.05"}],
          "blend_transition": 0.5
        },
        "swimming": {
          "animations": ["swim"],
          "transitions": [{"idle": "query.modified_move_speed <= 0.05"}],
          "blend_transition": 0.5
        }
      }
    },
    "controller.animation.zoocraft.whale_shark.feed": {
      "initial_state": "cruise",
      "states": {
        "cruise": {
          "transitions": [{"feeding": "query.property('zoocraft:feeding')"}],
          "blend_transition": 0.6
        },
        "feeding": {
          "animations": ["feed"],
          "transitions": [{"cruise": "!query.property('zoocraft:feeding')"}],
          "blend_transition": 0.6
        }
      }
    }
  }
}

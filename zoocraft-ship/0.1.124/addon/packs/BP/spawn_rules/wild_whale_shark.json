{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {"identifier": "zoocraft:wild_whale_shark", "population_control": "water_animal"},
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_underwater": {},
        "minecraft:brightness_filter": {"min": 7, "max": 15, "adjust_for_weather": false},
        "minecraft:height_filter": {"min": 40, "max": 64},
        "minecraft:weight": {"default": 2},
        "minecraft:herd": {"min_size": 1, "max_size": 1},
        "minecraft:density_limit": {"surface": 1},
        "minecraft:biome_filter": {
          "all_of": [
            {"test": "has_biome_tag", "value": "ocean"},
            {"test": "has_biome_tag", "value": "deep"},
            {
              "any_of": [
                {"test": "has_biome_tag", "value": "warm"},
                {"test": "has_biome_tag", "value": "lukewarm"}
              ]
            }
          ]
        }
      }
    ]
  }
}

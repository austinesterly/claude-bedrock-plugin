{
  "namespace": "redstone",
  "zoocraft_hanvil_background@common.dialog_background_opaque": {
    "texture": "textures/ui/zoocraft/hanvil/dialog"
  },
  "zoocraft_hanvil_cell": {
    "type": "image",
    "texture": "textures/ui/zoocraft/hanvil/cell",
    "layer": 1
  },
  "zoocraft_hanvil_slot@common.container_item": {
    "$background_images": "redstone.zoocraft_hanvil_cell"
  },
  "zoocraft_hanvil_grid@redstone.redstone_input_grid": {
    "grid_item_template": "redstone.zoocraft_hanvil_slot"
  },
  "zoocraft_hanvil_top_half": {
    "type": "panel",
    "size": [
      "100%",
      "50% - 12px"
    ],
    "offset": [
      0,
      7
    ],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "controls": [
      {
        "zoocraft_hanvil_grid@redstone.zoocraft_hanvil_grid": {}
      },
      {
        "zoocraft_hanvil_hammer": {
          "type": "image",
          "texture": "textures/ui/zoocraft/hanvil/hammer",
          "size": [
            36,
            18
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            9,
            -7
          ],
          "layer": 12
        }
      }
    ]
  },
  "zoocraft_hanvil_panel": {
    "type": "panel",
    "controls": [
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {}
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {}
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {}
      },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "size": "$screen_dimensions",
          "controls": [
            {
              "common_panel@common.common_panel": {
                "$dialog_background": "redstone.zoocraft_hanvil_background"
              }
            },
            {
              "redstone_screen_inventory": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  {
                    "red_panel@redstone.zoocraft_hanvil_top_half": {}
                  },
                  {
                    "red_bottom_half@common.inventory_panel_bottom_half_with_label": {}
                  },
                  {
                    "hotbar_grid@common.hotbar_grid_template": {}
                  },
                  {
                    "red_hold_icon@common.inventory_take_progress_icon_button": {}
                  }
                ]
              }
            },
            {
              "red_icon@common.inventory_selected_icon_button": {}
            },
            {
              "gamepad_cursor@common.gamepad_cursor_button": {}
            },
            {
              "$screen_label@$screen_label": {}
            }
          ]
        }
      },
      {
        "flying_item_renderer@common.flying_item_renderer": {
          "layer": 21
        }
      }
    ]
  },
  "zoocraft_melder_background@common.dialog_background_opaque": {
    "texture": "textures/ui/zoocraft/melder/dialog"
  },
  "zoocraft_melder_cell": {
    "type": "image",
    "texture": "textures/ui/zoocraft/melder/cell",
    "layer": 1
  },
  "zoocraft_melder_slot@common.container_item": {
    "$background_images": "redstone.zoocraft_melder_cell"
  },
  "zoocraft_melder_grid@redstone.redstone_input_grid": {
    "grid_item_template": "redstone.zoocraft_melder_slot"
  },
  "zoocraft_melder_top_half": {
    "type": "panel",
    "size": [
      "100%",
      "50% - 12px"
    ],
    "offset": [
      0,
      7
    ],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "controls": [
      {
        "zoocraft_melder_grid@redstone.zoocraft_melder_grid": {}
      },
      {
        "zoocraft_melder_hammer": {
          "type": "image",
          "texture": "textures/ui/zoocraft/melder/mix",
          "size": [
            36,
            18
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [
            9,
            -7
          ],
          "layer": 12
        }
      }
    ]
  },
  "zoocraft_melder_panel": {
    "type": "panel",
    "controls": [
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {}
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {}
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {}
      },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "size": "$screen_dimensions",
          "controls": [
            {
              "common_panel@common.common_panel": {
                "$dialog_background": "redstone.zoocraft_melder_background"
              }
            },
            {
              "redstone_screen_inventory": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  {
                    "red_panel@redstone.zoocraft_melder_top_half": {}
                  },
                  {
                    "red_bottom_half@common.inventory_panel_bottom_half_with_label": {}
                  },
                  {
                    "hotbar_grid@common.hotbar_grid_template": {}
                  },
                  {
                    "red_hold_icon@common.inventory_take_progress_icon_button": {}
                  }
                ]
              }
            },
            {
              "red_icon@common.inventory_selected_icon_button": {}
            },
            {
              "gamepad_cursor@common.gamepad_cursor_button": {}
            },
            {
              "$screen_label@$screen_label": {}
            }
          ]
        }
      },
      {
        "flying_item_renderer@common.flying_item_renderer": {
          "layer": 21
        }
      }
    ]
  },
  "hopper_screen": {
    "$zoocraft_title|default": "$container_title",
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": [
          {
            "requires": "(($zoocraft_title = 'entity.zoocraft:hanvil_store.name') and $desktop_screen)",
            "$screen_content": "redstone.zoocraft_hanvil_panel"
          },
          {
            "requires": "(($zoocraft_title = 'entity.zoocraft:melder_store.name') and $desktop_screen)",
            "$screen_content": "redstone.zoocraft_melder_panel"
          }
        ]
      }
    ]
  }
}

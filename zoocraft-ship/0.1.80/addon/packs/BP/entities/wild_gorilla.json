{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "zoocraft:wild_gorilla",
      "spawn_category": "creature",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {"zoocraft:act": {"type": "int", "range": [0, 18], "default": 0, "client_sync": true}}
    },
    "component_groups": {
      "zoocraft:moving": {
        "minecraft:movement": {"value": 0.2},
        "minecraft:physics": {},
        "minecraft:pushable_by_entity": {},
        "minecraft:behavior.look_at_player": {"priority": 9, "look_distance": 8, "probability": 0.03},
        "minecraft:behavior.random_look_around": {"priority": 10}
      },
      "zoocraft:still": {"minecraft:movement": {"value": 0.0}, "minecraft:physics": {}},
      "zoocraft:climbing": {
        "minecraft:movement": {"value": 0.0},
        "minecraft:physics": {"has_gravity": false, "has_collision": true}
      },
      "zoocraft:riding": {
        "minecraft:movement": {"value": 0.0},
        "minecraft:physics": {"has_gravity": false, "has_collision": false}
      },
      "zoocraft:denned": {
        "minecraft:movement": {"value": 0.0},
        "minecraft:physics": {"has_gravity": false, "has_collision": false}
      },
      "zoocraft:sex_0": {
        "minecraft:mark_variant": {"value": 0},
        "minecraft:collision_box": {"width": 1.0, "height": 1.05},
        "minecraft:health": {"value": 40, "max": 40}
      },
      "zoocraft:sex_1": {
        "minecraft:mark_variant": {"value": 1},
        "minecraft:collision_box": {"width": 1.2, "height": 1.3},
        "minecraft:health": {"value": 60, "max": 60}
      },
      "zoocraft:hunting": {
        "minecraft:behavior.look_at_player": {"priority": 8, "look_distance": 16, "probability": 0.2}
      },
      "zoocraft:calm": {
        "minecraft:behavior.tempt": {
          "priority": 2,
          "speed_multiplier": 1.0,
          "within_radius": 10,
          "items": [
            "zoocraft:fruit_ration",
            "zoocraft:leafy_ration",
            "apple",
            "sweet_berries",
            "melon_slice"
          ]
        }
      }
    },
    "components": {
      "minecraft:type_family": {"family": ["wild_gorilla", "gorilla", "mob"]},
      "minecraft:nameable": {},
      "minecraft:health": {"value": 40, "max": 40},
      "minecraft:damage_sensor": {"triggers": [{"cause": "fall", "deals_damage": "no"}]},
      "minecraft:despawn": {"despawn_from_distance": {}},
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:breathable": {"total_supply": 15, "suffocate_time": 0},
      "minecraft:collision_box": {"width": 1.0, "height": 1.05},
      "minecraft:navigation.walk": {"can_path_over_water": false, "avoid_water": true, "avoid_damage_blocks": true},
      "minecraft:movement.basic": {},
      "minecraft:movement": {"value": 0.2},
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:pushable_by_block": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:behavior.float": {"priority": 0},
      "minecraft:behavior.random_stroll": {"priority": 7, "interval": 160, "speed_multiplier": 0.8, "xz_dist": 6, "y_dist": 1}
    },
    "events": {
      "zoocraft:move": {
        "remove": {
          "component_groups": ["zoocraft:still", "zoocraft:climbing", "zoocraft:riding", "zoocraft:denned"]
        },
        "add": {"component_groups": ["zoocraft:moving"]}
      },
      "zoocraft:still": {
        "remove": {
          "component_groups": ["zoocraft:moving", "zoocraft:climbing", "zoocraft:riding", "zoocraft:denned"]
        },
        "add": {"component_groups": ["zoocraft:still"]}
      },
      "zoocraft:climb": {
        "remove": {
          "component_groups": ["zoocraft:moving", "zoocraft:still", "zoocraft:riding", "zoocraft:denned"]
        },
        "add": {"component_groups": ["zoocraft:climbing"]}
      },
      "zoocraft:ride": {
        "remove": {
          "component_groups": ["zoocraft:moving", "zoocraft:still", "zoocraft:climbing", "zoocraft:denned"]
        },
        "add": {"component_groups": ["zoocraft:riding"]}
      },
      "zoocraft:den_in": {
        "remove": {
          "component_groups": ["zoocraft:moving", "zoocraft:still", "zoocraft:climbing", "zoocraft:riding"]
        },
        "add": {"component_groups": ["zoocraft:denned"]}
      },
      "zoocraft:den_out": {
        "remove": {
          "component_groups": ["zoocraft:still", "zoocraft:climbing", "zoocraft:riding", "zoocraft:denned"]
        },
        "add": {"component_groups": ["zoocraft:moving"]}
      },
      "zoocraft:sex_0": {
        "remove": {"component_groups": ["zoocraft:sex_1"]},
        "add": {"component_groups": ["zoocraft:sex_0"]}
      },
      "zoocraft:sex_1": {
        "remove": {"component_groups": ["zoocraft:sex_0"]},
        "add": {"component_groups": ["zoocraft:sex_1"]}
      },
      "zoocraft:hunt": {
        "remove": {"component_groups": ["zoocraft:calm"]},
        "add": {"component_groups": ["zoocraft:hunting"]}
      },
      "zoocraft:calm": {
        "remove": {"component_groups": ["zoocraft:hunting"]},
        "add": {"component_groups": ["zoocraft:calm"]}
      },
      "minecraft:entity_spawned": {"add": {"component_groups": ["zoocraft:sex_1", "zoocraft:moving", "zoocraft:hunting"]}}
    }
  }
}

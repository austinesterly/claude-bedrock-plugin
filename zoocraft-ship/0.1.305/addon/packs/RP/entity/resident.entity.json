{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "zoocraft:resident",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "look0": "textures/entity/zoocraft/resident_0",
        "look1": "textures/entity/zoocraft/resident_1",
        "look2": "textures/entity/zoocraft/resident_2",
        "look3": "textures/entity/zoocraft/resident_3",
        "look4": "textures/entity/zoocraft/resident_4",
        "look5": "textures/entity/zoocraft/resident_5",
        "look6": "textures/entity/zoocraft/resident_6",
        "look7": "textures/entity/zoocraft/resident_7",
        "look8": "textures/entity/zoocraft/resident_8",
        "look9": "textures/entity/zoocraft/resident_9",
        "look10": "textures/entity/zoocraft/resident_10",
        "look11": "textures/entity/zoocraft/resident_11",
        "look12": "textures/entity/zoocraft/resident_12",
        "look13": "textures/entity/zoocraft/resident_13",
        "look14": "textures/entity/zoocraft/resident_14",
        "look15": "textures/entity/zoocraft/resident_15",
        "look16": "textures/entity/zoocraft/resident_16",
        "look17": "textures/entity/zoocraft/resident_17",
        "look18": "textures/entity/zoocraft/resident_18",
        "look19": "textures/entity/zoocraft/resident_19",
        "look20": "textures/entity/zoocraft/resident_20",
        "look21": "textures/entity/zoocraft/resident_21",
        "look22": "textures/entity/zoocraft/resident_22",
        "look23": "textures/entity/zoocraft/resident_23",
        "look24": "textures/entity/zoocraft/resident_24",
        "look25": "textures/entity/zoocraft/resident_25",
        "look26": "textures/entity/zoocraft/resident_26"
      },
      "geometry": {
        "default": "geometry.zoocraft.resident"
      },
      "animations": {
        "walk": "animation.zoocraft.guest.walk",
        "look_at_target": "animation.zoocraft.guest.look_at_target",
        "sleep": "animation.zoocraft.resident.sleep",
        "work": "animation.zoocraft.resident.work",
        "fish": "animation.zoocraft.resident.fish",
        "walk_robed": "animation.zoocraft.resident.walk_robed",
        "crossed": "animation.zoocraft.resident.crossed"
      },
      "scripts": {
        "animate": [
          {
            "walk": "!query.property('zoocraft:sleeping') && query.property('zoocraft:who') != 21"
          },
          {
            "walk_robed": "!query.property('zoocraft:sleeping') && query.property('zoocraft:who') == 21"
          },
          {
            "look_at_target": "!query.property('zoocraft:sleeping')"
          },
          {
            "sleep": "query.property('zoocraft:sleeping')"
          },
          {
            "work": "query.property('zoocraft:working') && query.property('zoocraft:who') != 20"
          },
          {
            "fish": "query.property('zoocraft:working') && query.property('zoocraft:who') == 20"
          },
          {
            "crossed": "query.property('zoocraft:who') == 21"
          }
        ]
      },
      "render_controllers": [
        "controller.render.zoocraft.resident"
      ]
    }
  }
}

{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "zoocraft:spruce_giant"
    },
    "mega_trunk": {
      "trunk_width": 2,
      "trunk_height": {
        "base": 20,
        "intervals": [
          4,
          8
        ]
      },
      "trunk_block": {
        "name": "minecraft:spruce_log"
      }
    },
    "mega_pine_canopy": {
      "canopy_height": {
        "range_min": 16,
        "range_max": 22
      },
      "base_radius": 0,
      "radius_step_modifier": 4.5,
      "core_width": 2,
      "leaf_block": {
        "name": "minecraft:spruce_leaves"
      }
    },
    "may_grow_on": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "base_block": "minecraft:podzol",
    "may_grow_through": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "may_replace": [
      "minecraft:air",
      "minecraft:snow_layer",
      {
        "tags": "query.any_tag('minecraft:leaves')"
      },
      "minecraft:short_grass",
      "minecraft:tall_grass",
      "minecraft:fern",
      "minecraft:large_fern",
      "minecraft:sweet_berry_bush"
    ],
    "base_cluster": {
      "may_replace": [
        "minecraft:grass_block",
        "minecraft:dirt",
        "minecraft:coarse_dirt"
      ],
      "num_clusters": 5,
      "cluster_radius": 2
    }
  }
}

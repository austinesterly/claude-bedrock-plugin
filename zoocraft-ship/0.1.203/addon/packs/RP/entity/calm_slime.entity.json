{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "zoocraft:calm_slime",
      "materials": {
        "default": "slime",
        "outer": "slime_outer"
      },
      "textures": {
        "default": "textures/entity/slime/slime"
      },
      "geometry": {
        "default": "geometry.zoocraft.zoo_slime"
      },
      "scripts": {
        "pre_animation": [
          "variable.sq_n = math.max(0, (query.life_time - variable.sq_t0) * 20);",
          "variable.squish_factor = (query.current_squish_value != 0 || query.previous_squish_value != 0) ? (query.previous_squish_value + (query.current_squish_value - query.previous_squish_value) * query.frame_alpha) : variable.sq_a * 5 * (math.pow(0.6, variable.sq_n) - math.pow(0.5, variable.sq_n));",
          "variable.bounce = 1 / ((variable.squish_factor / (query.variant * 0.5 + 1)) + 1);",
          "variable.horizontal_scale_amount = variable.bounce * query.variant;",
          "variable.vertical_scale_amount = (1 / variable.bounce) * query.variant;"
        ],
        "scaleX": "variable.horizontal_scale_amount",
        "scaleY": "variable.vertical_scale_amount",
        "scaleZ": "variable.horizontal_scale_amount",
        "initialize": [
          "variable.sq_t0 = 0;",
          "variable.sq_a = 0;"
        ],
        "animate": [
          "cube_squish"
        ]
      },
      "render_controllers": [
        "controller.render.zoocraft.zoo_slime",
        "controller.render.zoocraft.zoo_slime_outer"
      ],
      "animations": {
        "cube_squish": "controller.animation.zoocraft.cube_squish"
      },
      "sound_effects": {
        "jump": "mob.slime.big",
        "jump_tiny": "mob.slime.small",
        "land": "mob.slime.big"
      }
    }
  }
}

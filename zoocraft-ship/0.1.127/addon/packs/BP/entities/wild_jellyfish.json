{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "zoocraft:wild_jellyfish",
      "spawn_category": "water_creature",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {"zoocraft:flashing": {"type": "bool", "default": false, "client_sync": true}}
    },
    "component_groups": {
      "zoocraft:drifting": {
        "minecraft:timer": {
          "looping": false,
          "randomInterval": true,
          "time": [20, 50],
          "time_down_event": {"event": "zoocraft:flash"}
        }
      },
      "zoocraft:flashing": {
        "minecraft:timer": {"looping": false, "time": 2.5, "time_down_event": {"event": "zoocraft:drift"}}
      },
      "zoocraft:coat_0": {"minecraft:variant": {"value": 0}},
      "zoocraft:coat_1": {"minecraft:variant": {"value": 1}},
      "zoocraft:coat_2": {"minecraft:variant": {"value": 2}}
    },
    "components": {
      "minecraft:type_family": {"family": ["wild_jellyfish", "jellyfish", "aquatic", "mob"]},
      "minecraft:behavior.random_swim": {
        "priority": 3,
        "interval": 0,
        "speed_multiplier": 1,
        "xz_dist": 4,
        "y_dist": 2,
        "avoid_surface": true
      },
      "minecraft:behavior.swim_idle": {"priority": 5},
      "minecraft:health": {"value": 8, "max": 8},
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_air": false,
        "breathes_water": true,
        "generates_bubbles": false
      },
      "minecraft:collision_box": {"width": 1.0, "height": 1.6},
      "minecraft:navigation.generic": {
        "can_breach": false,
        "can_walk": false,
        "can_path_over_water": false,
        "can_sink": false,
        "can_swim": true,
        "is_amphibious": false,
        "using_door_annotation": true
      },
      "minecraft:movement.basic": {},
      "minecraft:movement": {"value": 0.01},
      "minecraft:underwater_movement": {"value": 0.01},
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:nameable": {},
      "minecraft:despawn": {"despawn_from_distance": {}}
    },
    "events": {
      "zoocraft:flash": {
        "remove": {"component_groups": ["zoocraft:drifting"]},
        "add": {"component_groups": ["zoocraft:flashing"]},
        "set_property": {"zoocraft:flashing": true}
      },
      "zoocraft:drift": {
        "remove": {"component_groups": ["zoocraft:flashing"]},
        "add": {"component_groups": ["zoocraft:drifting"]},
        "set_property": {"zoocraft:flashing": false}
      },
      "zoocraft:coat_0": {
        "remove": {"component_groups": ["zoocraft:coat_1", "zoocraft:coat_2"]},
        "add": {"component_groups": ["zoocraft:coat_0"]}
      },
      "zoocraft:coat_1": {
        "remove": {"component_groups": ["zoocraft:coat_0", "zoocraft:coat_2"]},
        "add": {"component_groups": ["zoocraft:coat_1"]}
      },
      "zoocraft:coat_2": {
        "remove": {"component_groups": ["zoocraft:coat_0", "zoocraft:coat_1"]},
        "add": {"component_groups": ["zoocraft:coat_2"]}
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {"add": {"component_groups": ["zoocraft:drifting"]}},
          {
            "randomize": [
              {"weight": 1, "add": {"component_groups": ["zoocraft:coat_0"]}},
              {"weight": 1, "add": {"component_groups": ["zoocraft:coat_1"]}},
              {"weight": 1, "add": {"component_groups": ["zoocraft:coat_2"]}}
            ]
          }
        ]
      }
    }
  }
}

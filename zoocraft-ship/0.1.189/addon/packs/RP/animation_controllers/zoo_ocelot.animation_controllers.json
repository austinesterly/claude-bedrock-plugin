{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.zoocraft.zoo_ocelot.look": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "look_at_target"
          ]
        }
      }
    },
    "controller.animation.zoocraft.zoo_ocelot.move": {
      "initial_state": "walking",
      "states": {
        "walking": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "sneaking": "variable.state == 0"
            },
            {
              "sprinting": "variable.state == 1"
            },
            {
              "lie_down": "variable.state == 4"
            }
          ]
        },
        "sneaking": {
          "animations": [
            "sneak"
          ],
          "transitions": [
            {
              "walking": "variable.state == 3"
            },
            {
              "sprinting": "variable.state == 1"
            },
            {
              "lie_down": "variable.state == 4"
            }
          ]
        },
        "sprinting": {
          "animations": [
            "sprint"
          ],
          "transitions": [
            {
              "walking": "variable.state == 3"
            },
            {
              "sneaking": "variable.state == 0"
            },
            {
              "lie_down": "variable.state == 4"
            }
          ]
        },
        "lie_down": {
          "animations": [
            "lie_down"
          ],
          "transitions": [
            {
              "walking": "variable.state == 3"
            },
            {
              "sneaking": "variable.state == 0"
            },
            {
              "sprinting": "variable.state == 1"
            }
          ]
        }
      }
    }
  }
}

{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "zoocraft:zoo_ocelot",
      "materials": {
        "default": "ocelot"
      },
      "textures": {
        "wild": "textures/entity/cat/ocelot"
      },
      "geometry": {
        "default": "geometry.ocelot.v1.8"
      },
      "scripts": {
        "pre_animation": [
          "variable.liedownamount = math.clamp((variable.liedownamount ?? 0) + (query.is_sleeping ? query.delta_time : -query.delta_time) * 2, 0, 1);",
          "variable.liedownamounttail = variable.liedownamount;",
          "variable.lieonplayer = 0;",
          "variable.state = query.is_sleeping ? 4 : (query.is_sneaking ? 0 : (query.is_sprinting ? 1 : 3));"
        ],
        "animate": [
          "look",
          "move",
          {
            "baby_transform": "query.is_baby"
          }
        ]
      },
      "animations": {
        "walk": "animation.ocelot.walk",
        "sneak": "animation.ocelot.sneak",
        "sprint": "animation.ocelot.sprint",
        "lie_down": "animation.cat.lie_down",
        "look_at_target": "animation.common.look_at_target",
        "baby_transform": "animation.zoocraft.zoo_ocelot.baby_transform",
        "look": "controller.animation.zoocraft.zoo_ocelot.look",
        "move": "controller.animation.zoocraft.zoo_ocelot.move"
      },
      "render_controllers": [
        "controller.render.zoocraft.zoo_ocelot"
      ]
    }
  }
}

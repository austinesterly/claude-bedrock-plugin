{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.zoocraft.zoo_sulfur_cube": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": "!variable.has_absorbed_block && !query.is_invisible"
        }
      ],
      "overlay_color": {
        "r": "variable.is_flashing ? 1.0 : this",
        "g": "variable.is_flashing ? 1.0 : this",
        "b": "variable.is_flashing ? 1.0 : this",
        "a": "variable.is_flashing ? 0.5 : this"
      }
    },
    "controller.render.zoocraft.zoo_sulfur_cube_outer": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.outer"
        }
      ],
      "part_visibility": [
        {
          "*": "!query.is_invisible"
        }
      ],
      "textures": [
        "Texture.outer"
      ]
    }
  }
}

{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {"identifier": "zoocraft:wild_catfish", "population_control": "water_animal"},
    "conditions": [
      {
        "minecraft:spawns_underwater": {},
        "minecraft:height_filter": {"min": 30, "max": 63},
        "minecraft:weight": {"default": 6},
        "minecraft:herd": {"min_size": 2, "max_size": 4},
        "minecraft:density_limit": {"surface": 4},
        "minecraft:biome_filter": {
          "any_of": [
            {
              "all_of": [
                {"test": "has_biome_tag", "value": "river"},
                {"test": "has_biome_tag", "operator": "!=", "value": "frozen"}
              ]
            },
            {"test": "has_biome_tag", "value": "swamp"},
            {"test": "has_biome_tag", "value": "mangrove_swamp"}
          ]
        }
      }
    ]
  }
}

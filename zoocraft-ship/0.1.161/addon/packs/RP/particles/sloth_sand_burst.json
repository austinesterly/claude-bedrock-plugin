{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "zoocraft:sloth_sand_burst",
      "basic_render_parameters": {"material": "particles_alpha", "texture": "textures/particle/particles"}
    },
    "components": {
      "minecraft:emitter_rate_instant": {"num_particles": 40},
      "minecraft:emitter_lifetime_once": {"active_time": 0.05},
      "minecraft:emitter_shape_disc": {"radius": 1.4, "plane_normal": "y", "direction": "outwards"},
      "minecraft:particle_lifetime_expression": {"max_lifetime": "0.7 + variable.particle_random_3 * 0.35"},
      "minecraft:particle_initial_speed": "6 * (0.6 + variable.particle_random_1 * 0.6)",
      "minecraft:particle_motion_dynamic": {"linear_acceleration": [0, -3, 0], "linear_drag_coefficient": 3.0},
      "minecraft:particle_appearance_billboard": {
        "size": ["0.28 + variable.particle_age * 0.28", "0.28 + variable.particle_age * 0.28"],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [56, 0],
            "size_UV": [8, 8],
            "step_UV": [-8, 0],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.4,
          0.31,
          0.23,
          "math.clamp((variable.particle_lifetime - variable.particle_age) * 1.5, 0, 0.9)"
        ]
      }
    }
  }
}

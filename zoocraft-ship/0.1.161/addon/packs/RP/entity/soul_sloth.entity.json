        "hang": "animation.zoocraft.soul_sloth.hang",
        "hang_sleep": "animation.zoocraft.soul_sloth.hang_sleep",
        "climb": "animation.zoocraft.soul_sloth.climb",
        "turn_up": "animation.zoocraft.soul_sloth.turn_up",
        "turn_down": "animation.zoocraft.soul_sloth.turn_down",
        "drop": "animation.zoocraft.soul_sloth.drop",
        "clump": "animation.zoocraft.soul_sloth.clump",
        "wisps": "animation.zoocraft.soul_sloth.wisps",
        "move": "controller.animation.zoocraft.soul_sloth.move"
      },
      "particle_effects": {"wisp": "zoocraft:sloth_soul_wisp"},
      "render_controllers": ["controller.render.zoocraft.soul_sloth"],
      "scripts": {
        "scale": "1.536",
        "initialize": [
          "variable.offset = math.random(0, 20);",
          "v.st = 0;",
          "v.act = 0;",
          "v.last_act = 0;",
          "v.act_t = 0;",
          "v.at = 0;",
          "v.moving = 0;",
          "v.clump = 0;",
          "v.wph = 0;"
        ],
        "pre_animation": [
          "v.act = q.property('zoocraft:act');",
          "v.act_t = (v.act != v.last_act) ? q.life_time : v.act_t;",
          "v.last_act = v.act;",
          "v.at = q.life_time - v.act_t;",
          "v.clump = (v.act == 3 && v.at > 0.5 && v.at < 1.08) ? 1 : 0;",
          "v.moving = q.modified_move_speed > 0.04;",
          "v.wph = (v.act == 15) ? (q.life_time * 200) : (q.modified_distance_moved * 30);"
        ],
        "animate": ["move", "clump", "wisps"]
      }
    }
  }
}

        "eat": "animation.zoocraft.soul_sloth.eat",
        "yawn": "animation.zoocraft.soul_sloth.yawn",
        "rake_ground": "animation.zoocraft.soul_sloth.rake_ground",
        "sit": "animation.zoocraft.soul_sloth.sit",
        "tired": "animation.zoocraft.soul_sloth.tired",
        "curl_sleep": "animation.zoocraft.soul_sloth.curl_sleep",
        "sit_down": "animation.zoocraft.soul_sloth.sit_down",
        "tired_down": "animation.zoocraft.soul_sloth.tired_down",
        "curl_sleep_down": "animation.zoocraft.soul_sloth.curl_sleep_down",
        "get_up": "animation.zoocraft.soul_sloth.get_up",

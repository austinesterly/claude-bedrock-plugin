{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "zoocraft:dragon_fire",
      "basic_render_parameters": {"material": "particles_blend", "texture": "textures/particle/particles"}
    },
    "components": {
      "minecraft:emitter_rate_instant": {"num_particles": 5},
      "minecraft:emitter_lifetime_once": {"active_time": 0.05},
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0],
        "direction": [
          "variable.dx + math.random(-0.12, 0.12)",
          "variable.dy + math.random(-0.08, 0.08)",
          "variable.dz + math.random(-0.12, 0.12)"
        ]
      },
      "minecraft:particle_lifetime_expression": {"max_lifetime": "0.55 + variable.particle_random_1 * 0.35"},
      "minecraft:particle_initial_speed": "7 + variable.particle_random_2 * 3",
      "minecraft:particle_motion_dynamic": {"linear_acceleration": [0, 1.6, 0], "linear_drag_coefficient": 2.4},
      "minecraft:particle_appearance_billboard": {
        "size": ["0.14 + variable.particle_age * 0.95", "0.14 + variable.particle_age * 0.95"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [56, 0],
            "size_UV": [8, 8],
            "step_UV": [-8, 0],
            "frames_per_second": 8,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.particle_age / variable.particle_lifetime < 0.25 ? math.lerp(1.0, variable.r, variable.particle_age / variable.particle_lifetime / 0.25) : math.lerp(variable.r, 0.22, (variable.particle_age / variable.particle_lifetime - 0.25) / 0.75)",
          "variable.particle_age / variable.particle_lifetime < 0.25 ? math.lerp(1.0, variable.g, variable.particle_age / variable.particle_lifetime / 0.25) : math.lerp(variable.g, 0.2, (variable.particle_age / variable.particle_lifetime - 0.25) / 0.75)",
          "variable.particle_age / variable.particle_lifetime < 0.25 ? math.lerp(1.0, variable.b, variable.particle_age / variable.particle_lifetime / 0.25) : math.lerp(variable.b, 0.2, (variable.particle_age / variable.particle_lifetime - 0.25) / 0.75)",
          "math.clamp(1.15 - variable.particle_age / variable.particle_lifetime * variable.particle_age / variable.particle_lifetime * 1.15, 0, 1)"
        ]
      }
    }
  }
}

{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "zoocraft:resident",
      "is_spawnable": false,
      "is_summonable": true,
      "properties": {
        "zoocraft:who": {
          "type": "int",
          "range": [
            0,
            63
          ],
          "default": 0,
          "client_sync": true
        },
        "zoocraft:walking": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "zoocraft:sleeping": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "zoocraft:working": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "zoocraft:awake": {
        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 6,
          "probability": 0.02
        },
        "minecraft:behavior.random_look_around": {
          "priority": 8
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "zoocraft_resident"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.8
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:physics": {},
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:fire_immune": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:movement": {
        "value": 0
      },
      "minecraft:nameable": {
        "always_show": true,
        "allow_name_tag_renaming": false
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              }
            },
            "interact_text": "action.interact.zoocraft.talk"
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "zoocraft:awake"
          ]
        }
      },
      "zoocraft:sleep": {
        "remove": {
          "component_groups": [
            "zoocraft:awake"
          ]
        }
      },
      "zoocraft:wake": {
        "add": {
          "component_groups": [
            "zoocraft:awake"
          ]
        }
      }
    }
  }
}

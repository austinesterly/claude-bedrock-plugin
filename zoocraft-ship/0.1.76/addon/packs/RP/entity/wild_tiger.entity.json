        "sleep_side": "animation.zoocraft.tiger.sleep_side",
        "sleep_back": "animation.zoocraft.tiger.sleep_back",
        "down_life": "animation.zoocraft.tiger.down_life",
        "sleep": "animation.zoocraft.tiger.sleep",
        "leg_rake_l": "animation.zoocraft.tiger.leg_rake_l",
        "leg_rake_r": "animation.zoocraft.tiger.leg_rake_r",
        "cub": "animation.zoocraft.tiger.cub",
        "eat_w": "animation.zoocraft.tiger.eat_w",
        "groom_w": "animation.zoocraft.tiger.groom_w",
        "soak_w": "animation.zoocraft.tiger.soak_w",
        "nurse_w": "animation.zoocraft.tiger.nurse_w",
        "roll_w": "animation.zoocraft.tiger.roll_w",
        "move": "controller.animation.zoocraft.tiger.move"
      },
      "render_controllers": ["controller.render.zoocraft.tiger"],
      "scripts": {
        "scale": "(q.is_baby ? 0.225 : (q.mark_variant == 1 ? 0.572 : 0.5))",
        "initialize": [
          "v.offset = math.random(0, 24);",
          "v.st = 0;",
          "v.act_st = 0;",
          "v.act_was = -1;",
          "v.is_down = 0;",
          "v.gait = 0;",
          "v.t_prev = 0;",
          "v.rest_head = 0;",
          "v.awake = 1;",
          "v.in_lie = 0;",
          "v.in_sleep = 0;",
          "v.in_back = 0;",
          "v.leg_rate = 1;",
          "v.posture = 0;",
          "v.lids = 0;",
          "v.eat_k = 0;",
          "v.nurse_k = 0;",
          "v.groom_k = 0;",
          "v.soak_k = 0;",
          "v.roll_k = 0;",
          "v.soak_lift = 0;",
          "v.in_side = 0;",
          "v.side_k = 0;",
          "v.back_k = 0;",
          "v.rake_l = 0;",
          "v.rake_r = 0;"
        ],
        "pre_animation": [
          "v.act = q.property('zoocraft:act');",
          "v.act_st = v.act != v.act_was ? q.life_time : v.act_st; v.act_was = v.act;",
          "v.posture = v.act == 19 ? 1 : ((v.act == 5 || v.act == 18 || v.act == 9 || v.act == 27) ? 2 : ((v.act == 6 || (v.act == 14 && !q.is_baby)) ? 3 : ((v.act == 7 || v.act == 31) ? 4 : 0)));",
          "v.gait = q.modified_move_speed <= 0.05 ? 0 : (q.ground_speed >= (v.gait == 3 ? 3.4 : 4.0) ? 3 : (q.ground_speed >= (v.gait >= 2 ? 1.5 : 1.9) ? 2 : 1));",
          "v.dt = math.clamp(q.life_time - v.t_prev, 0, 0.25); v.t_prev = q.life_time;",
          "v.rest_head = v.rest_head + math.clamp(v.in_lie * (v.act == 5 ? (math.clamp((math.mod(q.life_time + v.offset, 30) - 10) / 2.0, 0, 1) * math.clamp((22 - math.mod(q.life_time + v.offset, 30)) / 2.0, 0, 1)) : 0) - v.rest_head, -v.dt / 0.6, v.dt / 0.6);",
          "v.awake = v.awake + math.clamp((v.in_sleep && v.act != 14 ? 0 : 1) - v.awake, -v.dt / 1.5, v.dt / 1.5);",
          "v.lids = v.awake < 0.5;",
          "v.eat_k = v.eat_k + math.clamp((v.in_lie && v.act == 18 ? 1 : 0) - v.eat_k, -v.dt / 0.5, v.dt / 0.5);",
          "v.groom_k = v.groom_k + math.clamp((v.in_lie && v.act == 9 ? 1 : 0) - v.groom_k, -v.dt / 0.6, v.dt / 0.6);",
          "v.soak_k = v.soak_k + math.clamp((v.act == 27 ? 1 : 0) - v.soak_k, -v.dt / 1.2, v.dt / 1.6);",
          "v.nurse_k = v.nurse_k + math.clamp((v.in_side && v.act == 14 ? 1 : 0) - v.nurse_k, -v.dt / 0.6, v.dt / 0.6);",
          "v.roll_k = v.roll_k + math.clamp((v.in_back && v.act == 31 ? 1 : 0) - v.roll_k, -v.dt / 0.5, v.dt / 0.5);",
          "v.side_k = v.side_k + math.clamp(v.in_sleep - v.side_k, -v.dt / 1.2, v.dt / 1.2);",
          "v.back_k = v.back_k + math.clamp((v.posture == 4 ? 1 : 0) - v.back_k, -v.dt, v.dt);",
          "v.leg_rate = 0.5 / (q.is_baby ? 0.225 : (q.mark_variant == 1 ? 0.572 : 0.5));",
          "v.soak_lift = math.max(0, 25.5 * 0.5 / (q.is_baby ? 0.225 : (q.mark_variant == 1 ? 0.572 : 0.5)) - 16.6) * v.soak_k;",
          "v.trot_rate = (v.act == 21 ? 1 : math.clamp(q.ground_speed / 2.3, 0.5, 2)) * v.leg_rate;",
          "v.gallop_rate = (v.act == 22 ? 1 : math.clamp(q.ground_speed / 7.001, 0.5, 1.6)) * v.leg_rate;",
          "v.rake_l = v.act == 13 ? (v.act == 13 ? (math.mod(q.life_time - v.act_st + 0, 2.4) < 0.5 ? math.mod(q.life_time - v.act_st + 0, 2.4) : (math.mod(q.life_time - v.act_st + 0, 2.4) < 0.85 ? 0.5 + (math.mod(q.life_time - v.act_st + 0, 2.4) - 0.5) / 0.7 : (math.mod(q.life_time - v.act_st + 0, 2.4) < 1.2 ? 1 - (math.mod(q.life_time - v.act_st + 0, 2.4) - 0.85) / 0.35 : 0))) : 0) : math.max(0, v.rake_l - v.dt / 0.3);",
          "v.rake_r = v.act == 13 ? (v.act == 13 ? (math.mod(q.life_time - v.act_st + 1.2, 2.4) < 0.5 ? math.mod(q.life_time - v.act_st + 1.2, 2.4) : (math.mod(q.life_time - v.act_st + 1.2, 2.4) < 0.85 ? 0.5 + (math.mod(q.life_time - v.act_st + 1.2, 2.4) - 0.5) / 0.7 : (math.mod(q.life_time - v.act_st + 1.2, 2.4) < 1.2 ? 1 - (math.mod(q.life_time - v.act_st + 1.2, 2.4) - 0.85) / 0.35 : 0))) : 0) : math.max(0, v.rake_r - v.dt / 0.3);"
        ],
        "animate": [
          "move",
          {"cub": "q.is_baby"},
          {"leg_rake_l": "v.rake_l > 0"},
          {"leg_rake_r": "v.rake_r > 0"}
        ]
      },
      "spawn_egg": {"base_color": "#d9772b", "overlay_color": "#1c1410"}
    }
  }
}

{
  "namespace": "ns_forms",

  "long_form_router": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "vanilla_layout@server_form.long_form": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - '§v§w') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "wide_layout@ns_forms.wide_form": {
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§v§w') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  "wide_form@common_dialogs.main_panel_no_buttons": {
    "$wide_size": [ 340, 240 ],
    "variables": [
      { "requires": "$pocket_screen", "$wide_size": [ 300, 210 ] }
    ],
    "size": "$wide_size",
    "$title_panel": "common_dialogs.standard_title_label",
    "$title_size": [ "100% - 15px", 10 ],
    "$title_max_size": [ "100% - 15px", 10 ],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$title_text_color": [ 1.0, 0.84, 0.0 ],
    "$child_control": "server_form.long_form_panel",
    "layer": 2
  }
}

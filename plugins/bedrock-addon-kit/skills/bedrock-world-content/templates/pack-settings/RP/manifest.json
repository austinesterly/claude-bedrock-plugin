{
  "format_version": 3,
  "header": {
    "name": "My Add-on RP",
    "description": "Resource pack with pack settings",
    "uuid": "<rp-header-uuid>",
    "version": "1.0.0",
    "min_engine_version": "1.26.50"
  },
  "modules": [
    {
      "type": "resources",
      "uuid": "<rp-module-uuid>",
      "version": "1.0.0"
    }
  ],
  "settings": [
    {
      "type": "label",
      "text": "Visual options for My Add-on."
    },
    {
      "type": "toggle",
      "name": "ns:show_sparkles",
      "text": "Show sparkle particles",
      "default": true
    },
    {
      "type": "slider",
      "name": "ns:particle_density",
      "text": "Particle density",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "dropdown",
      "name": "ns:theme",
      "text": "Colour theme",
      "default": "ruby",
      "options": [
        {
          "name": "ruby",
          "text": "Ruby"
        },
        {
          "name": "emerald",
          "text": "Emerald"
        }
      ]
    },
    {
      "type": "multiselect",
      "name": "ns:hud_parts",
      "text": "HUD extras",
      "defaults": [
        "coins"
      ],
      "options": [
        {
          "name": "coins",
          "text": "Coin counter"
        },
        {
          "name": "compass",
          "text": "Compass"
        }
      ]
    }
  ]
}

{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "ns:townsfolk",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {
        "ns:activity": {
          "type": "enum",
          "values": [
            "work",
            "home"
          ],
          "default": "work"
        }
      }
    },
    "component_groups": {
      "ns:work_shift": {
        "minecraft:behavior.move_to_block": {
          "priority": 4,
          "speed_multiplier": 0.7,
          "tick_interval": 20,
          "start_chance": 1,
          "search_range": 32,
          "search_height": 6,
          "goal_radius": 2,
          "target_selection_method": "nearest",
          "target_blocks": [
            "minecraft:smithing_table"
          ],
          "stay_duration": 200
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.6,
          "xz_dist": 3,
          "y_dist": 1,
          "interval": 200
        },
        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 8,
          "look_time": {
            "min": 2,
            "max": 4
          }
        }
      },
      "ns:night_home": {
        "minecraft:behavior.go_home": {
          "priority": 3,
          "speed_multiplier": 0.8,
          "interval": 1,
          "goal_radius": 1.5,
          "calculate_new_path_radius": 2
        },
        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 4,
          "look_time": {
            "min": 1,
            "max": 2
          }
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "ns_npc",
          "ns_townsfolk",
          "mob"
        ]
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "deals_damage": "no"
        }
      },
      "minecraft:fire_immune": {},
      "minecraft:loot": {
        "table": "loot_tables/empty.json"
      },
      "minecraft:persistent": {},
      "minecraft:physics": {},
      "minecraft:nameable": {
        "allow_name_tag_renaming": true,
        "always_show": false
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "avoid_water": true,
        "avoid_damage_blocks": true,
        "can_pass_doors": true,
        "can_open_doors": true
      },
      "minecraft:annotation.open_door": {},
      "minecraft:preferred_path": {
        "default_block_cost": 3,
        "jump_cost": 20,
        "preferred_path_blocks": [
          {
            "blocks": [
              "grass_path"
            ],
            "cost": 0
          },
          {
            "blocks": [
              "cobblestone",
              "stone_bricks",
              "oak_planks",
              "spruce_planks"
            ],
            "cost": 1
          }
        ]
      },
      "minecraft:jump.static": {},
      "minecraft:home": {
        "restriction_type": "none"
      },
      "minecraft:ambient_sound_interval": {
        "value": 25,
        "range": 25,
        "event_name": "ambient"
      },
      "minecraft:scheduler": {
        "min_delay_secs": 0,
        "max_delay_secs": 10,
        "scheduled_events": [
          {
            "event": "ns:start_work",
            "filters": {
              "all_of": [
                {
                  "test": "hourly_clock_time",
                  "operator": ">=",
                  "value": 0
                },
                {
                  "test": "hourly_clock_time",
                  "operator": "<",
                  "value": 11000
                }
              ]
            }
          },
          {
            "event": "ns:go_home",
            "filters": {
              "all_of": [
                {
                  "test": "hourly_clock_time",
                  "operator": ">=",
                  "value": 11000
                },
                {
                  "test": "hourly_clock_time",
                  "operator": "<",
                  "value": 24000
                }
              ]
            }
          }
        ]
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:interact": {
        "interactions": [
          {
            "interact_text": "action.interact.ns.talk",
            "swing": false,
            "cooldown": 1,
            "on_interact": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "event": "ns:interacted",
              "target": "self"
            }
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "ns:work_shift"
          ]
        },
        "set_property": {
          "ns:activity": "work"
        }
      },
      "ns:start_work": {
        "remove": {
          "component_groups": [
            "ns:night_home"
          ]
        },
        "add": {
          "component_groups": [
            "ns:work_shift"
          ]
        },
        "set_property": {
          "ns:activity": "work"
        }
      },
      "ns:go_home": {
        "remove": {
          "component_groups": [
            "ns:work_shift"
          ]
        },
        "add": {
          "component_groups": [
            "ns:night_home"
          ]
        },
        "set_property": {
          "ns:activity": "home"
        }
      },
      "ns:interacted": {}
    }
  }
}

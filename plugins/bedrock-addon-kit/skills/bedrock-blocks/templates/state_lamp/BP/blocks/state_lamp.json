{
  "format_version": "1.26.50",
  "minecraft:block": {
    "description": {
      "identifier": "ns:state_lamp",
      "menu_category": {
        "category": "construction"
      },
      "states": {
        "ns:level": [0, 1, 2, 3]
      }
    },
    "components": {
      "minecraft:geometry": "minecraft:geometry.full_block",
      "minecraft:material_instances": {
        "*": {
          "texture": "ns_lamp_off",
          "render_method": "opaque"
        }
      },
      "minecraft:light_emission": 0,
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.3
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 0.3
      },
      "minecraft:map_color": "#c8a050",
      "ns:cycle_state": {
        "state": "ns:level",
        "max": 3
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('ns:level') == 1",
        "components": {
          "minecraft:geometry": "minecraft:geometry.full_block",
          "minecraft:material_instances": {
            "*": {
              "texture": "ns_lamp_on",
              "render_method": "opaque"
            }
          },
          "minecraft:light_emission": 5
        }
      },
      {
        "condition": "query.block_state('ns:level') == 2",
        "components": {
          "minecraft:geometry": "minecraft:geometry.full_block",
          "minecraft:material_instances": {
            "*": {
              "texture": "ns_lamp_on",
              "render_method": "opaque"
            }
          },
          "minecraft:light_emission": 10
        }
      },
      {
        "condition": "query.block_state('ns:level') == 3",
        "components": {
          "minecraft:geometry": "minecraft:geometry.full_block",
          "minecraft:material_instances": {
            "*": {
              "texture": "ns_lamp_on",
              "render_method": "opaque"
            }
          },
          "minecraft:light_emission": 15
        }
      }
    ]
  }
}

{
  "format_version": "1.26.50",
  "minecraft:item": {
    "description": {
      "identifier": "ns:ruby_pickaxe",
      "menu_category": {
        "category": "equipment",
        "group": "minecraft:itemGroup.name.pickaxe"
      }
    },
    "components": {
      "minecraft:icon": {
        "textures": {
          "default": "ns:ruby_pickaxe"
        }
      },
      "minecraft:display_name": {
        "value": "item.ns:ruby_pickaxe.name"
      },
      "minecraft:max_stack_size": {
        "value": 1
      },
      "minecraft:hand_equipped": {
        "value": true
      },
      "minecraft:damage": {
        "value": 5
      },
      "minecraft:durability": {
        "max_durability": 1200
      },
      "minecraft:enchantable": {
        "slot": "pickaxe",
        "value": 10
      },
      "minecraft:repairable": {
        "repair_items": [
          {
            "items": [
              "ns:ruby_pickaxe"
            ],
            "repair_amount": "context.other->query.remaining_durability"
          },
          {
            "items": [
              "minecraft:diamond"
            ],
            "repair_amount": "query.max_durability * 0.25"
          }
        ]
      },
      "minecraft:digger": {
        "use_efficiency": true,
        "destroy_speeds": [
          {
            "block": {
              "tags": "query.any_tag('minecraft:is_pickaxe_item_destructible')"
            },
            "speed": 8
          }
        ]
      },
      "minecraft:tags": {
        "tags": [
          "minecraft:is_pickaxe",
          "minecraft:is_tool",
          "minecraft:digger",
          "minecraft:diamond_tier"
        ]
      }
    }
  }
}

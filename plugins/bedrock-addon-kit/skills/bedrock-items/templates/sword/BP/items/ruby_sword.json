{
  "format_version": "1.26.50",
  "minecraft:item": {
    "description": {
      "identifier": "ns:ruby_sword",
      "menu_category": {
        "category": "equipment",
        "group": "minecraft:itemGroup.name.sword"
      }
    },
    "components": {
      "minecraft:icon": {
        "textures": {
          "default": "ns:ruby_sword"
        }
      },
      "minecraft:display_name": {
        "value": "item.ns:ruby_sword.name"
      },
      "minecraft:max_stack_size": {
        "value": 1
      },
      "minecraft:hand_equipped": {
        "value": true
      },
      "minecraft:damage": {
        "value": 7
      },
      "minecraft:durability": {
        "max_durability": 1200
      },
      "minecraft:enchantable": {
        "slot": "sword",
        "value": 10
      },
      "minecraft:repairable": {
        "repair_items": [
          {
            "items": [
              "ns:ruby_sword"
            ],
            "repair_amount": "context.other->query.remaining_durability"
          },
          {
            "items": [
              "minecraft:diamond"
            ],
            "repair_amount": "query.max_durability * 0.25"
          }
        ]
      },
      "minecraft:can_destroy_in_creative": {
        "value": false
      },
      "minecraft:digger": {
        "use_efficiency": false,
        "destroy_speeds": [
          {
            "block": {
              "tags": "query.any_tag('minecraft:is_sword_item_destructible')"
            },
            "speed": 15
          }
        ]
      },
      "minecraft:tags": {
        "tags": [
          "minecraft:is_sword",
          "minecraft:is_tool"
        ]
      }
    }
  }
}

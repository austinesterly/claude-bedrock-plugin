{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.ns.ruby_bow": {
      "arrays": {
        "textures": {
          "array.bow_texture_frames": [
            "texture.default",
            "texture.ruby_bow_pulling_0",
            "texture.ruby_bow_pulling_1",
            "texture.ruby_bow_pulling_2"
          ]
        },
        "geometries": {
          "array.bow_geo_frames": [
            "geometry.default",
            "geometry.ruby_bow_pulling_0",
            "geometry.ruby_bow_pulling_1",
            "geometry.ruby_bow_pulling_2"
          ]
        }
      },
      "geometry": "array.bow_geo_frames[variable.bow_tex_idx]",
      "materials": [
        {
          "*": "variable.is_enchanted ? material.enchanted : material.default"
        }
      ],
      "textures": [
        "array.bow_texture_frames[variable.bow_tex_idx]",
        "texture.enchanted"
      ]
    }
  }
}

{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "ns:merchant",
      "is_spawnable": true,
      "is_summonable": true,
      "spawn_category": "creature"
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "ns_merchant",
          "mob"
        ]
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:movement": {
        "value": 0.5
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "avoid_water": true,
        "can_pass_doors": true,
        "can_path_over_water": true
      },
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:leashable": {
        "unleash_on_removal": false
      },
      "minecraft:trade_table": {
        "display_name": "entity.ns:merchant.name",
        "table": "trading/ns_merchant_trades.json",
        "new_screen": true,
        "persist_trades": true
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/ns_merchant.json"
      },
      "minecraft:ambient_sound_interval": {
        "value": 8,
        "range": 16,
        "event_name": "ambient"
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.trade_with_player": {
        "priority": 1,
        "filters": {
          "all_of": [
            {
              "test": "in_water",
              "value": false
            },
            {
              "test": "on_ground",
              "value": true
            }
          ]
        }
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 0.6
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 2,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "zombie"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "zombie_villager"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "illager"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "vex"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "zoglin"
                },
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "ns_ghoul"
                }
              ]
            },
            "max_dist": 6,
            "walk_speed_multiplier": 0.6,
            "sprint_speed_multiplier": 0.6
          }
        ]
      },
      "minecraft:behavior.look_at_trading_player": {
        "priority": 4,
        "look_time": {
          "min": 1,
          "max": 2
        }
      },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.6
      },
      "minecraft:behavior.look_at_player": {
        "priority": 8,
        "look_distance": 8,
        "look_time": {
          "min": 1,
          "max": 2
        }
      },
      "minecraft:behavior.random_look_around": {
        "priority": 9
      }
    }
  }
}

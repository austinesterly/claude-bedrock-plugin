{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ns.titan.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "attacking": "v.attack_time > 0.0"
            }
          ],
          "blend_transition": 0.1,
          "blend_via_shortest_path": true
        },
        "attacking": {
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "default": "v.attack_time <= 0.0"
            }
          ],
          "blend_transition": 0.1,
          "blend_via_shortest_path": true
        }
      }
    }
  }
}

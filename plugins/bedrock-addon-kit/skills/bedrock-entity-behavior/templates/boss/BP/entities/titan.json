      "properties": {
        "ns:phase": {
          "type": "int",
          "range": [
            1,
            3
          ],
          "default": 1,
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "ns:phase_1": {
        "minecraft:movement": {
          "value": 0.22
        },
        "minecraft:attack": {
          "damage": 8
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "speed_multiplier": 1,
          "track_target": true,
          "cooldown_time": 1.5
        }
      },
      "ns:phase_2": {
        "minecraft:movement": {
          "value": 0.27
        },
        "minecraft:attack": {
          "damage": 12
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "speed_multiplier": 1.15,
          "track_target": true,
          "cooldown_time": 1.2
        }
      },
      "ns:phase_3": {
        "minecraft:movement": {
          "value": 0.32
        },
        "minecraft:attack": {
          "damage": 16
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "speed_multiplier": 1.3,
          "track_target": true,
          "cooldown_time": 0.8
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "ns_titan",
          "monster",
          "mob"
        ]
      },
      "minecraft:boss": {
        "hud_range": 55,
        "should_darken_sky": true
      },
      "minecraft:health": {
        "value": 300,
        "max": 300
      },
      "minecraft:collision_box": {
        "width": 1.4,
        "height": 3.9
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:pushable_by_block": {},
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_water": true
      },
      "minecraft:nameable": {},
      "minecraft:persistent": {},
      "minecraft:fire_immune": {},
      "minecraft:knockback_resistance": {
        "value": 1
      },
      "minecraft:follow_range": {
        "value": 48,
        "max": 48
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/ns_titan.json"
      },
      "minecraft:experience_reward": {
        "on_death": "50"
      },
      "minecraft:ambient_sound_interval": {
        "value": 10,
        "range": 10,
        "event_name": "ambient"
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": "no"
          }
        ]
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "int_property",
                  "subject": "self",
                  "domain": "ns:phase",
                  "operator": "==",
                  "value": 1
                },
                {
                  "test": "actor_health",
                  "subject": "self",
                  "operator": "<=",
                  "value": 200
                }
              ]
            },
            "event": "ns:enter_phase_2"
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "int_property",
                  "subject": "self",
                  "domain": "ns:phase",
                  "operator": "==",
                  "value": 2
                },
                {
                  "test": "actor_health",
                  "subject": "self",
                  "operator": "<=",
                  "value": 100
                }
              ]
            },
            "event": "ns:enter_phase_3"
          }
        ]
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": false,
        "reselect_targets": true,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 32
          }
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 16
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "ns:phase_1"
          ]
        }
      },
      "ns:enter_phase_2": {
        "remove": {
          "component_groups": [
            "ns:phase_1"
          ]
        },
        "add": {
          "component_groups": [
            "ns:phase_2"
          ]
        },
        "set_property": {
          "ns:phase": 2
        },
        "play_sound": {
          "sound": "roar"
        }
      },
      "ns:enter_phase_3": {
        "remove": {
          "component_groups": [
            "ns:phase_2"
          ]
        },
        "add": {
          "component_groups": [
            "ns:phase_3"
          ]
        },
        "set_property": {
          "ns:phase": 3
        },
        "play_sound": {
          "sound": "roar"
        }
      }
    }
  }
}

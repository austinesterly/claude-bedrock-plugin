        "priority": 9,
        "look_distance": 6
      },
      "minecraft:behavior.random_look_around": {
        "priority": 10
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "randomize": [
          {
            "weight": 9,
            "add": {
              "component_groups": [
                "ns:pup_adult",
                "ns:pup_wild"
              ]
            }
          },
          {
            "weight": 1,
            "add": {
              "component_groups": [
                "ns:pup_baby",
                "ns:pup_wild"
              ]
            }
          }
        ]
      },
      "minecraft:entity_born": {
        "sequence": [
          {
            "filters": {
              "test": "is_tamed"
            },
            "add": {
              "component_groups": [
                "ns:pup_baby",
                "ns:pup_tame"
              ]
            }
          },
          {
            "filters": {
              "test": "is_tamed",
              "value": false
            },
            "add": {
              "component_groups": [
                "ns:pup_baby",
                "ns:pup_wild"
              ]
            }
          }
        ]
      },
      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": [
            "ns:pup_baby"
          ]
        },
        "add": {
          "component_groups": [
            "ns:pup_adult"
          ]
        }
      },
      "ns:on_tame": {
        "remove": {
          "component_groups": [
            "ns:pup_wild"
          ]
        },
        "add": {
          "component_groups": [
            "ns:pup_tame"
          ]
        }
      },
      "ns:spawn_tame_adult": {
        "add": {
          "component_groups": [
            "ns:pup_adult",
            "ns:pup_tame"
          ]
        }
      }

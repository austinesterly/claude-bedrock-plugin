{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ns.spitter.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "aiming": "q.has_target"
            }
          ],
          "blend_transition": 0.2,
          "blend_via_shortest_path": true
        },
        "aiming": {
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "default": "!q.has_target"
            }
          ],
          "blend_transition": 0.2,
          "blend_via_shortest_path": true
        }
      }
    }
  }
}
